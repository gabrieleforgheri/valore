                            <div class="bg-purple-50 p-4 rounded-2xl border border-purple-100 text-center">
                                <span class="block text-2xl font-bold text-purple-700">{{ stats.totalVisits || 0 }}</span>
                                <span class="text-xs font-semibold text-purple-600 uppercase tracking-wide">Visite Totali</span>
                            </div>
                            <div class="bg-purple-50 p-4 rounded-2xl border border-purple-100 text-center">
                                <span class="block text-2xl font-bold text-purple-700">{{ stats.totalClicks || 0 }}</span>
                                <span class="text-xs font-semibold text-purple-600 uppercase tracking-wide">Clic Totali sui Link</span>
                            </div>
                        </div>
                        <div v-if="stats.orphanClicks" class="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 text-xs text-amber-800 leading-snug">
                            <strong>{{ stats.orphanClicks }}</strong> clic non corrispondono più a nessun link o social attuale (link eliminato, oppure titolo <em>e</em> URL cambiati entrambi). Restano nel database e li trovi nel filtro qui sotto sotto la voce “Non più presenti”.
                        </div>
                    </div>

                    <!-- 2. SOCIALS -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-4">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">2. Socials</h3>
                        <div v-if="!stats.socialClicks || stats.socialClicks.length === 0" class="text-xs text-gray-400 italic bg-gray-50 p-4 rounded-2xl text-center">
                            Nessun social link presente.
                        </div>
                        <div v-else class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div v-for="s in stats.socialClicks" :key="s.id" class="bg-gray-50 p-3.5 rounded-2xl border border-gray-200 flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-2xl bg-black text-white flex items-center justify-center font-bold text-xs uppercase shadow-sm">
                                        {{ s.platform ? s.platform.substring(0, 2) : 'SO' }}
                                    </div>
                                    <span class="font-bold text-sm text-gray-800 capitalize">{{ s.platform || 'Social' }}</span>
                                </div>
                                <span class="px-3 py-1 bg-white border border-gray-200 rounded-full font-mono text-xs font-bold text-purple-700 shadow-sm">
                                    {{ s.count || 0 }} clic
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. LINKBOX -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-4">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">3. LinkBox</h3>
                        <div v-if="!stats.linkClicks || stats.linkClicks.length === 0" class="text-xs text-gray-400 italic bg-gray-50 p-4 rounded-2xl text-center">
                            Nessun link box presente.
                        </div>
                        <div v-else class="space-y-2.5">
                            <div v-for="l in stats.linkClicks" :key="l.id" class="bg-gray-50 p-3.5 rounded-2xl border border-gray-200 flex items-center justify-between gap-3">
                                <span class="font-bold text-sm truncate" :class="l.enabled === false ? 'text-gray-400' : 'text-gray-800'">{{ l.title }}</span>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span v-if="l.enabled === false" class="px-2 py-0.5 bg-gray-200 text-gray-600 rounded-full text-[10px] font-bold uppercase tracking-wide" title="Nascosto dalla pagina pubblica, statistiche conservate">Nascosto</span>
                                    <span class="px-3 py-1 bg-white border border-gray-200 rounded-full font-mono text-xs font-bold text-purple-700 shadow-sm">
                                        {{ l.count || 0 }} clic
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. GRAFICO & ESPORTAZIONE -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">4. Grafico Clic Giornalieri</h3>
                                <p class="text-[11px] text-gray-400 mt-0.5">Seleziona un intervallo (max 31 giorni)</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <input type="date" v-model="chartStartDate" @change="fetchChartData" class="px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold text-gray-700">
                                <span class="text-xs font-bold text-gray-400">a</span>
                                <input type="date" v-model="chartEndDate" @change="fetchChartData" class="px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold text-gray-700">
                                <button @click="exportCSV" class="px-3.5 py-1.5 bg-black hover:bg-gray-800 text-white font-semibold rounded-xl text-xs transition-colors shadow-sm flex items-center gap-1.5">
                                    <span>📥</span> Esporta CSV
                                </button>
                            </div>
                        </div>

                        <!-- Target selection: drives both the chart and the CSV -->
                        <div class="bg-gray-50 rounded-2xl border border-gray-200">
                            <button @click="showChartFilter = !showChartFilter" type="button" class="w-full flex items-center justify-between gap-3 px-4 py-3 text-left">
                                <div class="min-w-0">
                                    <span class="text-xs font-bold text-gray-700">Quali elementi includere</span>
                                    <p class="text-[11px] text-gray-500 truncate">{{ chartFilterSummary }}</p>
                                </div>
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="shrink-0 text-gray-400 transition-transform" :class="showChartFilter ? 'rotate-180' : ''"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
                            </button>
                            <div v-show="showChartFilter" class="px-4 pb-4 space-y-3 border-t border-gray-200 pt-3">
                                <div class="flex flex-wrap gap-2">
                                    <button @click="selectAllTargets" type="button" class="px-2.5 py-1 bg-white border border-gray-200 rounded-lg text-[11px] font-bold text-gray-700 hover:bg-gray-100">Tutti</button>
                                    <button @click="selectNoTargets" type="button" class="px-2.5 py-1 bg-white border border-gray-200 rounded-lg text-[11px] font-bold text-gray-700 hover:bg-gray-100">Nessuno</button>
                                    <button @click="selectOnlyKind('link')" type="button" class="px-2.5 py-1 bg-white border border-gray-200 rounded-lg text-[11px] font-bold text-gray-700 hover:bg-gray-100">Solo link</button>
                                    <button @click="selectOnlyKind('social')" type="button" class="px-2.5 py-1 bg-white border border-gray-200 rounded-lg text-[11px] font-bold text-gray-700 hover:bg-gray-100">Solo social</button>
                                    <button @click="selectVisibleLinks" type="button" class="px-2.5 py-1 bg-white border border-gray-200 rounded-lg text-[11px] font-bold text-gray-700 hover:bg-gray-100">Solo link visibili</button>
                                </div>
                                <div class="max-h-56 overflow-y-auto space-y-1.5 pr-1">
                                    <label v-for="t in chartTargets" :key="t.key" class="flex items-center gap-2.5 px-2.5 py-1.5 bg-white border border-gray-200 rounded-xl cursor-pointer hover:border-gray-300">
                                        <input type="checkbox" :value="t.key" v-model="selectedTargets" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500 w-4 h-4 cursor-pointer shrink-0">
                                        <span class="w-2.5 h-2.5 rounded-full shrink-0" :style="{ background: targetColor(t.key) }"></span>
                                        <span class="text-xs font-semibold truncate" :class="t.hidden ? 'text-gray-400' : 'text-gray-800'">{{ t.label }}</span>
                                        <span v-if="t.hidden" class="px-1.5 py-0.5 bg-gray-100 text-gray-500 rounded text-[9px] font-bold uppercase shrink-0">Nascosto</span>
                                        <span class="ml-auto text-[10px] font-mono font-bold text-gray-400 shrink-0">{{ targetTotals[t.key] || 0 }}</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 h-64 relative">
                            <canvas id="clicksChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- SECTIONS TAB -->
                <div v-show="currentTab === 'sections'" class="space-y-6">
                    <!-- Spaziature & Margini Pagina -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-6">
                        <div>
                            <h2 class="text-lg font-bold">Spaziature & Margini Pagina</h2>
                            <p class="text-xs text-gray-400 mt-0.5">Personalizza la distanza tra i link, tra i blocchi e i margini della pagina (in pixel)</p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Distanza tra i Link -->
                            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-2.5">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-gray-700">Distanza tra i Link</label>
                                    <span class="text-xs font-mono font-bold bg-white px-2 py-0.5 rounded border border-gray-200">{{ profile.linkGap || 14 }} px</span>
                                </div>
                                <div class="flex gap-2 items-center">
                                    <select v-model="linkGapPreset" @change="onLinkGapPresetChange" class="flex-1 p-2 bg-white border border-gray-200 rounded-xl text-xs font-semibold focus:outline-none">
                                        <option value="8">Compatta (8px)</option>
                                        <option value="12">Normale (12px)</option>
                                        <option value="16">Spaziata (16px)</option>
                                        <option value="24">Ampia (24px)</option>
                                        <option value="custom">Personalizzata...</option>
                                    </select>
                                    <input type="number" min="0" max="64" v-model.number="profile.linkGap" @input="debouncedUpdatePreview" class="w-16 p-2 bg-white border border-gray-200 rounded-xl text-xs font-bold text-center">
                                </div>
                            </div>



                            <!-- Margine dall'Alto (Top) -->
                            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-2.5">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-gray-700">Distanza dall'Alto (Top)</label>
                                    <span class="text-xs font-mono font-bold bg-white px-2 py-0.5 rounded border border-gray-200">{{ profile.paddingTop || 24 }} px</span>
                                </div>
                                <div class="flex gap-2 items-center">
                                    <input type="range" min="0" max="120" step="4" v-model.number="profile.paddingTop" @input="debouncedUpdatePreview" class="flex-1 accent-black cursor-pointer">
                                    <input type="number" min="0" max="200" v-model.number="profile.paddingTop" @input="debouncedUpdatePreview" class="w-16 p-2 bg-white border border-gray-200 rounded-xl text-xs font-bold text-center">
                                </div>
                            </div>

                            <!-- Margine dal Basso (Bottom) -->
                            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-2.5">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-gray-700">Distanza dal Basso (Bottom)</label>
                                    <span class="text-xs font-mono font-bold bg-white px-2 py-0.5 rounded border border-gray-200">{{ profile.paddingBottom || 32 }} px</span>
                                </div>
                                <div class="flex gap-2 items-center">
                                    <input type="range" min="0" max="120" step="4" v-model.number="profile.paddingBottom" @input="debouncedUpdatePreview" class="flex-1 accent-black cursor-pointer">
                                    <input type="number" min="0" max="200" v-model.number="profile.paddingBottom" @input="debouncedUpdatePreview" class="w-16 p-2 bg-white border border-gray-200 rounded-xl text-xs font-bold text-center">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ordine Sezioni Drag & Drop -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-2">Ordine Sezioni</h2>
                        <p class="text-sm text-gray-500 mb-6">Trascina le sezioni (drag and drop) o usa le frecce per stabilire l'ordine dei blocchi nella pagina.</p>
                        
                        <div class="space-y-3" ref="sectionsList">
                            <div v-for="(sec, index) in (profile.sectionOrder && profile.sectionOrder.length ? profile.sectionOrder : ['profile', 'socials', 'business_mail', 'links'])" :key="sec" class="bg-gray-50 p-4 rounded-2xl border border-gray-200 flex flex-col shadow-sm hover:border-black transition-all">
                                <div class="flex items-center justify-between cursor-move">
                                    <div class="flex items-center gap-3">
                                        <div class="drag-handle p-2 text-gray-400 hover:text-black cursor-grab">
                                            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-8a2 2 0 1 0-.001-4.001A2 2 0 0 0 13 6zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"></path></svg>
                                        </div>
                                        <span class="font-bold text-sm text-gray-800">
                                            {{ sec === 'profile' ? 'Foto profilo, Nome e Bio' :
                                               sec === 'socials' ? 'Icone Social' :
                                               sec === 'business_mail' ? 'Pulsante Business Email' :
                                               sec === 'links' ? 'Elenco dei Link e Box in evidenza' : sec }}
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <button @click="moveSectionUp(index)" :disabled="index === 0" class="p-1.5 text-gray-400 hover:text-black disabled:opacity-30" title="Sposta su">
                                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                                        </button>
                                        <button @click="moveSectionDown(index)" :disabled="index === (profile.sectionOrder ? profile.sectionOrder.length - 1 : 3)" class="p-1.5 text-gray-400 hover:text-black disabled:opacity-30" title="Sposta giù">
                                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </button>
                                    </div>
                                </div>
                                <div v-if="index < (profile.sectionOrder ? profile.sectionOrder.length - 1 : 3)" class="mt-3 pt-3 border-t border-gray-200 flex items-center justify-between cursor-default">
                                    <label class="text-xs font-bold text-gray-600">Distanza sotto questa sezione</label>
                                    <div class="flex gap-2 items-center w-[55%]">
                                        <input type="range" min="0" max="64" step="2" v-model.number="profile.sectionGaps[sec]" @input="debouncedUpdatePreview" class="flex-1 accent-black cursor-pointer">
                                        <input type="number" min="0" max="100" v-model.number="profile.sectionGaps[sec]" @input="debouncedUpdatePreview" class="w-14 p-1 bg-white border border-gray-200 rounded text-xs font-bold text-center">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Live Preview -->
            <div :class="showMobilePreview ? 'fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4' : 'hidden md:block w-full md:w-[45%] lg:w-[40%] xl:w-[35%] sticky top-20'">
                <div class="border-[8px] border-black rounded-[3rem] overflow-hidden shadow-2xl h-[700px] w-full max-w-[340px] mx-auto flex flex-col relative transition-all" :class="showMobilePreview ? 'scale-100' : ''">
                    <div class="absolute top-0 inset-x-0 h-6 bg-black z-20 flex justify-center rounded-b-xl w-32 mx-auto"></div>
                    <iframe id="preview-frame" src="/preview" class="w-full h-full border-0 bg-white z-10"></iframe>
                    
                    <button v-if="showMobilePreview" @click="showMobilePreview = false" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black text-white px-4 py-2 rounded-full text-sm z-30">Chiudi</button>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        const initialData = <%- JSON.stringify(data) %>;
        const initialStats = <%- JSON.stringify(stats) %>;
        
        const { createApp } = Vue;

        if (!initialData.profile.sectionOrder || !Array.isArray(initialData.profile.sectionOrder) || initialData.profile.sectionOrder.length === 0) {
            initialData.profile.sectionOrder = ['profile', 'socials', 'business_mail', 'links'];
        }
        if (!initialData.profile.sectionGaps) initialData.profile.sectionGaps = {};
        const oldGap = initialData.profile.sectionGap !== undefined ? initialData.profile.sectionGap : 16;
        ['profile', 'socials', 'business_mail', 'links'].forEach(s => {
            if (initialData.profile.sectionGaps[s] === undefined) initialData.profile.sectionGaps[s] = oldGap;
        });
        if (initialData.profile.linkGap === undefined) initialData.profile.linkGap = 14;
        if (initialData.profile.paddingTop === undefined) initialData.profile.paddingTop = 24;
        if (initialData.profile.paddingBottom === undefined) initialData.profile.paddingBottom = 32;
        if (initialData.profile.businessMailOpacity === undefined) initialData.profile.businessMailOpacity = 100;

        if (initialData.links && Array.isArray(initialData.links)) {
            initialData.links.forEach(l => {
                if (!l.iconChoice) l.iconChoice = l.customIcon ? 'custom' : 'auto';
                // Everything saved before the visibility switch existed was visible.
                if (l.enabled === undefined) l.enabled = true;
                if (l.fontSize === undefined) l.fontSize = '';
            });
        }

        // Chart series colours. Index 0 is the aggregate line.
        const CHART_PALETTE = [
            '#9333ea', '#2563eb', '#059669', '#d97706', '#dc2626', '#0891b2',
            '#7c3aed', '#65a30d', '#db2777', '#0d9488', '#ea580c', '#4f46e5'
        ];

        const app = createApp({
            data() {
                const initialLinkGap = initialData.profile.linkGap !== undefined ? initialData.profile.linkGap : 14;
                const startDate = new Date(Date.now() - 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
                const endDate = new Date().toISOString().split('T')[0];
                return {
                    currentTab: 'links',
                    showMobilePreview: false,
                    profile: initialData.profile,
                    theme: initialData.theme || {
                        bgType: 'gradient', gradientDirection: 'to bottom', bgColor1: '#0B152C', bgColor2: '#4E769B',
                        fontColor: '#ffffff', btnBg: 'transparent', btnText: '#fce7ff', btnRadius: '0px'
                    },
                    links: initialData.links,
                    socials: initialData.socials || [],
                    stats: initialStats || { totalVisits: 0, totalClicks: 0, orphanClicks: 0, socialClicks: [], linkClicks: [] },
                    saving: false,
                    previewTimeout: null,
                    linkGapPreset: [8, 12, 16, 24].includes(initialLinkGap) ? String(initialLinkGap) : 'custom',
                    chartStartDate: startDate,
                    chartEndDate: endDate,
                    chartInstance: null,
                    detailedChartData: [],
                    // Which links / socials feed the chart and the CSV export.
                    // Everything is selected until the owner narrows it down.
                    selectedTargets: [
                        ...(initialData.links || []).map(l => 'link:' + l.id),
                        ...(initialData.socials || []).map(s => 'social:' + s.id),
                        'other'
                    ],
                    showChartFilter: false,
                    uploading: false,
                    uploadLabel: '',
                    dirty: false,
                    sectionsSortableReady: false,
                    _statsInterval: null
                }
            },
            mounted() {
                this.$nextTick(() => {
                    if (this.$refs.linksList) {
                        Sortable.create(this.$refs.linksList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.links.splice(evt.oldIndex, 1)[0];
                                this.links.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                    if (this.$refs.socialsList) {
                        Sortable.create(this.$refs.socialsList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.socials.splice(evt.oldIndex, 1)[0];
                                this.socials.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                    this.initSectionsSortable();
                });
            },
            computed: {
                linkThumbInset() {
                    const v = Number(this.theme.linkThumbInset);
                    return Number.isFinite(v) ? Math.min(Math.max(Math.round(v), 0), 16) : 4;
                },
                // The filter list is built from the live editor model, not from the
                // stats payload, so a link renamed but not yet published still shows
                // under the name on screen.
                chartTargets() {
                    return [
                        ...this.links.map(l => ({
                            key: 'link:' + l.id,
                            label: l.title || 'Link senza titolo',
                            kind: 'link',
                            hidden: l.enabled === false
                        })),
                        ...this.socials.map(s => ({
                            key: 'social:' + s.id,
                            label: 'Social: ' + (s.platform || 'link').toUpperCase(),
                            kind: 'social',
                            hidden: false
                        })),
                        { key: 'other', label: 'Non più presenti', kind: 'other', hidden: false }
                    ];
                },
                filteredChartRows() {
                    const selected = new Set(this.selectedTargets);
                    return this.detailedChartData.filter(r => selected.has(r.targetKey || 'other'));
                },
                targetTotals() {
                    const totals = {};
                    this.detailedChartData.forEach(r => {
                        const key = r.targetKey || 'other';
                        totals[key] = (totals[key] || 0) + (r.count || 0);
                    });
                    return totals;
                },
                chartFilterSummary() {
                    const total = this.chartTargets.length;
                    const n = this.chartTargets.filter(t => this.selectedTargets.includes(t.key)).length;
                    if (n === 0) return 'Nessun elemento selezionato';
                    if (n === total) return 'Tutti gli elementi (' + total + ')';
                    if (n <= 3) {
                        return this.chartTargets.filter(t => this.selectedTargets.includes(t.key)).map(t => t.label).join(', ');
                    }
                    return n + ' elementi su ' + total;
                }
            },
            watch: {
                selectedTargets: {
                    deep: true,
                    handler() {
                        if (this.currentTab === 'stats') this.renderChart();
                    }
                },
                currentTab(newTab, oldTab) {
                    if (newTab !== 'stats' && this._statsInterval) {
                        clearInterval(this._statsInterval);
                        this._statsInterval = null;
                    }
                }
            },
            beforeUnmount() {
                if (this._statsInterval) {
                    clearInterval(this._statsInterval);
                    this._statsInterval = null;
                }
            },
            methods: {
                initChart() {
                    this.$nextTick(async () => {
                        await this.fetchChartData();
                        await this.fetchLiveStats();
                        // Start real-time polling (every 5s)
                        if (this._statsInterval) clearInterval(this._statsInterval);
                        this._statsInterval = setInterval(() => {
                            this.fetchLiveStats();
                            this.fetchChartData();
                        }, 5000);
                    });
                },
                async fetchLiveStats() {
                    try {
                        const res = await fetch('/admin/api/stats');
                        const data = await res.json();
                        if (data.success) {
                            this.stats.totalVisits = data.totalVisits;
                            this.stats.totalClicks = data.totalClicks;
                            this.stats.socialClicks = data.socialClicks;
                            this.stats.linkClicks = data.linkClicks;
                            this.stats.orphanClicks = data.orphanClicks || 0;
                        }
                    } catch(e) {
                        console.error('Error fetching live stats:', e);
                    }
                },
                async fetchChartData() {
                    const start = new Date(this.chartStartDate);
                    const end = new Date(this.chartEndDate);
                    const diffDays = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
                    
                    if (diffDays > 31) {
                        alert("L'intervallo di date massimo selezionabile per il grafico è di 31 giorni (1 mese).");
                        const maxStart = new Date(end.getTime() - 30 * 24 * 60 * 60 * 1000);
                        this.chartStartDate = maxStart.toISOString().split('T')[0];
                    }
                    
                    try {
                        const res = await fetch(`/admin/api/analytics?startDate=${this.chartStartDate}&endDate=${this.chartEndDate}`);
                        const data = await res.json();
                        if (data.success) {
                            this.detailedChartData = data.detailedClicks || [];
                            this.renderChart();
                        }
                    } catch(e) {
                        console.error('Error fetching chart data:', e);
                    }
                },
                targetColor(key) {
                    const index = this.chartTargets.findIndex(t => t.key === key);
                    return CHART_PALETTE[(index < 0 ? 0 : index) % CHART_PALETTE.length];
                },
                selectAllTargets() {
                    this.selectedTargets = this.chartTargets.map(t => t.key);
                },
                selectNoTargets() {
                    this.selectedTargets = [];
                },
                selectOnlyKind(kind) {
                    this.selectedTargets = this.chartTargets.filter(t => t.kind === kind).map(t => t.key);
                },
                selectVisibleLinks() {
                    this.selectedTargets = this.chartTargets.filter(t => t.kind === 'link' && !t.hidden).map(t => t.key);
                },
                // Every day in the interval, not only the days that happen to have
                // clicks: otherwise the x-axis changes shape as soon as the filter
                // narrows, and two selections cannot be compared by eye.
                chartDateRange() {
                    const pad = n => String(n).padStart(2, '0');
                    const fmt = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
                    const out = [];
                    const cursor = new Date(this.chartStartDate + 'T00:00:00');
                    const end = new Date(this.chartEndDate + 'T00:00:00');
                    if (isNaN(cursor) || isNaN(end)) return [this.chartStartDate];
                    while (cursor <= end && out.length < 62) {
                        out.push(fmt(cursor));
                        cursor.setDate(cursor.getDate() + 1);
                    }
                    return out.length ? out : [this.chartStartDate];
                },
                renderChart() {
                    const ctx = document.getElementById('clicksChart');
                    if (!ctx) return;

                    const labels = this.chartDateRange();
                    const perTarget = new Map();
                    const totals = {};
                    this.filteredChartRows.forEach(row => {
                        const key = row.targetKey || 'other';
                        if (!perTarget.has(key)) perTarget.set(key, {});
                        const series = perTarget.get(key);
                        series[row.date] = (series[row.date] || 0) + (row.count || 0);
                        totals[row.date] = (totals[row.date] || 0) + (row.count || 0);
                    });

                    const labelFor = key => {
                        const t = this.chartTargets.find(x => x.key === key);
                        return t ? t.label : key;
                    };

                    const datasets = [];
                    // One line per element when the selection is small enough to
                    // stay readable; above that only the aggregate is drawn.
                    const perTargetLines = perTarget.size > 1 && perTarget.size <= 12;

                    if (perTarget.size !== 1) {
                        datasets.push({
                            label: 'Totale selezione',
                            data: labels.map(d => totals[d] || 0),
                            borderColor: '#111827',
                            backgroundColor: 'rgba(17, 24, 39, 0.06)',
                            fill: !perTargetLines,
                            tension: 0.3,
                            borderWidth: 3,
                            pointRadius: 3,
                            pointHoverRadius: 5
                        });
                    }

                    if (perTargetLines || perTarget.size === 1) {
                        perTarget.forEach((series, key) => {
                            const color = this.targetColor(key);
                            datasets.push({
                                label: labelFor(key),
                                data: labels.map(d => series[d] || 0),
                                borderColor: color,
                                backgroundColor: color + '1a',
                                fill: perTarget.size === 1,
                                tension: 0.3,
                                borderWidth: 2,
                                pointRadius: 2,
                                pointHoverRadius: 5,
                                pointBackgroundColor: color
                            });
                        });
                    }

                    if (!datasets.length) {
                        datasets.push({
                            label: this.selectedTargets.length ? 'Nessun clic nel periodo' : 'Nessun elemento selezionato',
                            data: labels.map(() => 0),
                            borderColor: '#d1d5db',
                            backgroundColor: 'rgba(209, 213, 219, 0.15)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 0
                        });
                    }

                    if (this.chartInstance) this.chartInstance.destroy();

                    this.chartInstance = new Chart(ctx, {
                        type: 'line',
                        data: { labels, datasets },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: {
                                legend: {
                                    display: datasets.length > 1,
                                    position: 'bottom',
                                    labels: { boxWidth: 10, boxHeight: 10, font: { size: 10 }, usePointStyle: true }
                                }
                            },
                            scales: {
                                y: { beginAtZero: true, ticks: { precision: 0 } }
                            }
                        }
                    });
                },
                exportCSV() {
                    const rows = this.filteredChartRows;
                    if (!rows.length) {
                        alert(this.selectedTargets.length
                            ? "Nessun dato disponibile nel periodo e per la selezione correnti."
                            : "Nessun elemento selezionato: scegli almeno un link o social da esportare.");
                        return;
                    }

                    const csvField = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
                    const kindLabel = { link: 'Link', social: 'Social', other: 'Non più presente' };

                    let csv = "Data;Tipo;Elemento;Titolo registrato al clic;URL;Clic\n";
                    rows.forEach(row => {
                        csv += [
                            csvField(row.date || ''),
                            csvField(kindLabel[row.targetKind] || 'Sconosciuto'),
                            csvField(row.targetName || ''),
                            csvField(row.linkTitle || ''),
                            csvField(row.linkUrl || ''),
                            row.count || 0
                        ].join(';') + "\n";
                    });

                    // Excel in Italian opens UTF-8 as mojibake without the BOM.
                    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `analytics_report_${this.chartStartDate}_to_${this.chartEndDate}.csv`;
                    a.click();
                    URL.revokeObjectURL(url);
                },
                onLinkGapPresetChange() {
                    if (this.linkGapPreset !== 'custom') {
                        this.profile.linkGap = parseInt(this.linkGapPreset, 10);
                        this.debouncedUpdatePreview();
                    }
                },
                initSectionsSortable() {
                    this.$nextTick(() => {
                        if (this.$refs.sectionsList && !this.sectionsSortableReady) {
                            this.sectionsSortableReady = true;
                            Sortable.create(this.$refs.sectionsList, {
                                handle: '.drag-handle',
                                animation: 150,
                                onEnd: (evt) => {
                                    const item = this.profile.sectionOrder.splice(evt.oldIndex, 1)[0];
                                    this.profile.sectionOrder.splice(evt.newIndex, 0, item);
                                    this.debouncedUpdatePreview();
                                }
                            });
                        }
                    });
                },
                moveSectionUp(index) {
                    if (index > 0 && this.profile.sectionOrder) {
                        const item = this.profile.sectionOrder.splice(index, 1)[0];
                        this.profile.sectionOrder.splice(index - 1, 0, item);
                        this.profile.sectionOrder = [...this.profile.sectionOrder];
                        this.debouncedUpdatePreview();
                    }
                },
                moveSectionDown(index) {
                    if (this.profile.sectionOrder && index < this.profile.sectionOrder.length - 1) {
                        const item = this.profile.sectionOrder.splice(index, 1)[0];
                        this.profile.sectionOrder.splice(index + 1, 0, item);
                        this.profile.sectionOrder = [...this.profile.sectionOrder];
                        this.debouncedUpdatePreview();
                    }
                },
                readFileAsDataUrl(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = e => resolve(e.target.result);
                        reader.onerror = () => reject(new Error('Impossibile leggere il file dal disco.'));
                        reader.readAsDataURL(file);
                    });
                },

                // A photo straight off a phone or a camera is routinely 10-30 MB and
                // 6000px wide. Sent as it is, it either blew past the 8 MB the server
                // accepts or past the 25 MB request limit — the second case coming
                // back as a 413 with an HTML body, so the dashboard reported "errore
                // di rete" and the picture just never appeared. None of that size is
                // any use: the widest a link image is ever drawn is a few hundred
                // pixels. So it is scaled down and recompressed here, and only then
                // uploaded.
                async prepareImage(file) {
                    const MAX_SIDE = 1600;
                    const RECODE_OVER = 1.2 * 1024 * 1024;
                    const HARD_LIMIT = 8 * 1024 * 1024;

                    // Rasterising an SVG throws away its resolution and rasterising a
                    // GIF throws away the animation, so those two go up untouched.
                    if (/^image\/(svg\+xml|gif)$/i.test(file.type)) {
                        if (file.size > HARD_LIMIT) {
                            throw new Error('Questo ' + (/gif/i.test(file.type) ? 'GIF' : 'SVG') + ' pesa ' + Math.round(file.size / 1048576) + ' MB: il limite è 8 MB e questo formato non può essere ricompresso senza rovinarlo.');
                        }
                        return await this.readFileAsDataUrl(file);
                    }

                    let source;
                    try {
                        source = await createImageBitmap(file);
                    } catch (e) {
                        // Safari needs the data URL route; it is also how HEIC from an
                        // iPhone becomes something a canvas can draw.
                        const dataUrl = await this.readFileAsDataUrl(file);
                        source = await new Promise((resolve, reject) => {
                            const img = new Image();
                            img.onload = () => resolve(img);
                            img.onerror = () => reject(new Error('Il browser non riesce ad aprire questo file come immagine' + (file.type ? ' (' + file.type + ')' : '') + '.'));
                            img.src = dataUrl;
                        });
                    }

                    const width = source.width || source.naturalWidth;
                    const height = source.height || source.naturalHeight;
                    if (!width || !height) throw new Error('Immagine senza dimensioni leggibili.');

                    const scale = Math.min(1, MAX_SIDE / Math.max(width, height));
                    const mustRecode = file.size > RECODE_OVER || !/^image\/(png|jpeg|webp)$/i.test(file.type);
                    if (scale === 1 && !mustRecode) return await this.readFileAsDataUrl(file);

                    const canvas = document.createElement('canvas');
                    canvas.width = Math.max(1, Math.round(width * scale));
                    canvas.height = Math.max(1, Math.round(height * scale));
                    const ctx = canvas.getContext('2d');
                    ctx.imageSmoothingEnabled = true;
                    ctx.imageSmoothingQuality = 'high';
                    ctx.drawImage(source, 0, 0, canvas.width, canvas.height);
                    if (source.close) source.close();

                    // WebP keeps the alpha channel and is much smaller than PNG on a
                    // photograph. PNG is the fallback for browsers that cannot encode it.
                    let quality = 0.9;
                    let out = canvas.toDataURL('image/webp', quality);
                    const webpWorks = /^data:image\/webp/.test(out);
                    if (!webpWorks) out = canvas.toDataURL('image/png');

                    while (webpWorks && out.length * 0.75 > HARD_LIMIT && quality > 0.4) {
                        quality -= 0.15;
                        out = canvas.toDataURL('image/webp', quality);
                    }
                    if (out.length * 0.75 > HARD_LIMIT) {
                        throw new Error("Non è stato possibile portare l'immagine sotto gli 8 MB. Prova a ridurla prima di caricarla.");
                    }
                    return out;
                },

                async uploadFile(event, callback) {
                    const input = event.target;
                    const file = input.files && input.files[0];
                    if (!file) return;

                    this.uploading = true;
                    this.uploadLabel = file.name;
                    try {
                        const base64 = await this.prepareImage(file);
                        const res = await fetch('/admin/upload-image', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ base64: base64, filename: file.name })
                        });
                        let data = null;
                        try {
                            data = await res.json();
                        } catch (e) {
                            throw new Error('Il server ha risposto ' + res.status + ' senza un messaggio leggibile.');
                        }
                        if (!data.success) throw new Error(data.error || 'errore sconosciuto');
                        callback(data.url);
                        this.debouncedUpdatePreview();
                    } catch (err) {
                        alert('Immagine non caricata.\n\n' + (err && err.message ? err.message : err));
                    } finally {
                        this.uploading = false;
                        // Without this, picking the same file again after a failure
                        // fires no change event at all and nothing appears to happen.
                        input.value = '';
                    }
                },
                addSocial() {
                    this.socials.push({
                        id: Date.now().toString(),
                        platform: 'instagram',
                        url: 'https://instagram.com/',
                        icon: ''
                    });
                    this.debouncedUpdatePreview();
                },
                removeSocial(index) {
                    if(confirm('Sei sicuro di voler eliminare questo social?')) {
                        this.socials.splice(index, 1);
                        this.debouncedUpdatePreview();
                    }
                },
                // Hiding instead of deleting: the entry stays in data.json, so the
                // clicks recorded against its URL and title keep being attributed
                // to it. Repurposing an existing link is what loses the history.
                toggleLink(link) {
                    link.enabled = link.enabled === false;
                    this.debouncedUpdatePreview();
                },
                addLink() {
                    this.links.unshift({
                        id: Date.now().toString(),
                        title: 'Nuovo Link',
                        url: 'https://',
                        subtitle: '',
                        enabled: true,
                        fontSize: '',
                        featured: false,
                        featuredSize: '3',
                        iconChoice: 'auto',
                        customIcon: '',
                        thumbnail: '',
                        transparent: false,
                        bgColor: ''
                    });
                    // Otherwise a link created after the page loaded would be
                    // silently missing from the chart and the export.
                    this.selectedTargets.push('link:' + this.links[0].id);
                    this.debouncedUpdatePreview();
                },
                removeLink(index) {
                    if(confirm('Sei sicuro di voler eliminare questo link?')) {
                        this.links.splice(index, 1);
                        this.debouncedUpdatePreview();
                    }
                },
                async fetchLinkMeta(link) {
                    if (!link.url || link.url === 'https://') return alert("Inserisci prima un URL valido.");
                    let detected = null;
                    const url = link.url.trim();
                    const igMatch = url.match(/instagram\.com\/([^/?#]+)/i);
                    if (igMatch && igMatch[1] && !['www', 'p', 'reel', 'reels', 'explore', 'stories'].includes(igMatch[1].toLowerCase())) detected = '@' + igMatch[1];
                    const tkMatch = url.match(/tiktok\.com\/@?([^/?#]+)/i);
                    if (!detected && tkMatch && tkMatch[1] && !['video', 'foryou', 'explore', 'live'].includes(tkMatch[1].toLowerCase())) detected = '@' + tkMatch[1].replace(/^@/, '');
                    const ytMatch = url.match(/youtube\.com\/@([^/?#]+)/i);
                    if (!detected && ytMatch && ytMatch[1]) detected = '@' + ytMatch[1];
                    
                    if (detected) {
                        link.subtitle = detected;
                        this.debouncedUpdatePreview();
                        return;
                    }
                    
                    try {
                        const res = await fetch('/admin/fetch-url-meta', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ url: link.url })
                        });
                        const data = await res.json();
                        if (data.success && (data.username || data.title)) {
                            if (data.title && (!link.title || link.title === 'Nuovo Link')) link.title = data.title;
                            if (data.username && !link.subtitle) link.subtitle = data.username;
                            this.debouncedUpdatePreview();
                        } else {
                            alert("Non è stato possibile estrarre dati automatici da questo URL.");
                        }
                    } catch (e) {
                        alert("Errore durante il recupero dei dati.");
                    }
                },
                debouncedUpdatePreview() {
                    this.dirty = true;
                    clearTimeout(this.previewTimeout);
                    this.previewTimeout = setTimeout(() => {
                        this.updatePreview();
                    }, 250);
                },
                async updatePreview() {
                    try {
                        await fetch('/admin/preview', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                profile: this.profile,
                                links: this.links,
                                socials: this.socials,
                                theme: this.theme
                            })
                        });
                        const iframe = document.getElementById('preview-frame');
                        if (iframe) iframe.src = '/preview?t=' + Date.now();
                    } catch(e) {
                        console.error('Errore update preview:', e);
                    }
                },
                // Mirrors the ratios in views/index.ejs, so the editor states what
                // the page will actually render rather than only the title size.
                captionPx(v) {
                    const n = Math.min(Math.max(Math.round(Number(v)) || 16, 8), 48);
                    return Math.min(Math.max(Math.round(n * 0.75), 9), 26);
                },
                iconPx(v) {
                    const n = Math.min(Math.max(Math.round(Number(v)) || 16, 8), 48);
                    return Math.min(Math.max(Math.round(n * 1.125), 12), 40);
                },
                // The two border colours are stored as CSS colour strings, because
                // they need an alpha channel and <input type="color"> has none.
                // These three keep a swatch, an opacity slider and the exact text
                // value in sync with each other.
                hexOf(value, fallback) {
                    const v = String(value == null ? '' : value).trim();
                    let m = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(v);
                    if (m) {
                        let h = m[1].toLowerCase();
                        if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
                        return '#' + h;
                    }
                    m = /^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/i.exec(v);
                    if (m) {
                        const to = n => Math.min(255, Math.max(0, parseInt(n, 10))).toString(16).padStart(2, '0');
                        return '#' + to(m[1]) + to(m[2]) + to(m[3]);
                    }
                    return fallback || '#ffffff';
                },
                alphaOf(value) {
                    const v = String(value == null ? '' : value).trim();
                    if (!v || /^(transparent|none)$/i.test(v)) return v ? 0 : 100;
                    const m = /^rgba\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*,\s*([0-9.]+)\s*\)$/i.exec(v);
                    if (m) return Math.round(Math.min(1, Math.max(0, parseFloat(m[1]))) * 100);
                    return 100;
                },
                rgbaFrom(hex, alphaPercent) {
                    const h = this.hexOf(hex, '#ffffff').slice(1);
                    const r = parseInt(h.slice(0, 2), 16);
                    const g = parseInt(h.slice(2, 4), 16);
                    const b = parseInt(h.slice(4, 6), 16);
                    const a = Math.min(100, Math.max(0, Number(alphaPercent) || 0)) / 100;
                    return a >= 1 ? '#' + h : `rgba(${r},${g},${b},${a})`;
                },
                assetUrl(value) {
                    if (!value) return '';
                    return /^(https?:|data:|\/)/.test(value) ? value : '/' + value;
                },
                discardChanges() {
                    if (confirm('Annullare le modifiche non pubblicate e ricaricare la pagina?')) {
                        this.dirty = false;
                        location.reload();
                    }
                },
                async save() {
                    this.saving = true;
                    try {
                        const res = await fetch('/admin/save', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                profile: this.profile,
                                links: this.links,
                                socials: this.socials,
                                theme: this.theme
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.dirty = false;
                            alert('Modifiche pubblicate con successo!');
                            this.updatePreview();
                        } else {
                            alert('Errore durante il salvataggio: ' + data.error);
                        }
                    } catch(e) {
                        alert('Errore di connessione durante il salvataggio.');
                    } finally {
                        this.saving = false;
                    }
                }
            }
        });

        const vm = app.mount('#app');

        // Nothing warned before that pending edits were about to be lost.
        window.addEventListener('beforeunload', (e) => {
            if (vm.dirty) { e.preventDefault(); e.returnValue = ''; }
        });
    </script>
</body>
</html>
