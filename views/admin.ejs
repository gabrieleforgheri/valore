<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Valore Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <style>
        body { background: #f3f4f6; }
        .drag-handle { cursor: grab; }
        .drag-handle:active { cursor: grabbing; }
        /* Toggle Switch */
        .toggle-checkbox:checked { right: 0; border-color: #68D391; }
        .toggle-checkbox:checked + .toggle-label { background-color: #68D391; }
    </style>
</head>
<body class="text-gray-800 font-sans antialiased overflow-x-hidden">
    <div id="app" class="min-h-screen pb-20">
        <!-- Navbar -->
        <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-6xl mx-auto px-4 h-16 flex justify-between items-center">
                <div class="flex items-center gap-6">
                    <img :src="'/' + profile.image" class="w-10 h-10 rounded-full object-cover shadow-sm border border-gray-100">
                    <div class="hidden sm:flex gap-1">
                        <button @click="currentTab = 'links'" :class="currentTab === 'links' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Links</button>
                        <button @click="currentTab = 'socials'" :class="currentTab === 'socials' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Socials</button>
                        <button @click="currentTab = 'appearance'" :class="currentTab === 'appearance' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Aspetto</button>
                        <button @click="currentTab = 'stats'" :class="currentTab === 'stats' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Statistiche</button>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button @click="showMobilePreview = !showMobilePreview" class="md:hidden px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-full">Anteprima</button>
                    <a href="/" target="_blank" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors hidden sm:block">Vedi Sito</a>
                    <button @click="save" class="px-5 py-2 text-sm font-semibold text-white bg-black hover:bg-gray-800 rounded-full transition-colors shadow-md flex items-center gap-2">
                        <span v-if="saving">Salvataggio...</span>
                        <span v-else>Pubblica Modifiche</span>
                    </button>
                </div>
            </div>
            <!-- Mobile Tabs -->
            <div class="sm:hidden flex border-t border-gray-100">
                <button @click="currentTab = 'links'" :class="currentTab === 'links' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Links</button>
                <button @click="currentTab = 'socials'" :class="currentTab === 'socials' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Socials</button>
                <button @click="currentTab = 'appearance'" :class="currentTab === 'appearance' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Aspetto</button>
                <button @click="currentTab = 'stats'" :class="currentTab === 'stats' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Statistiche</button>
            </div>
        </nav>

        <div class="max-w-6xl mx-auto px-4 mt-8 grid grid-cols-1 md:grid-cols-12 gap-8">
            
            <!-- Left Column: Editor -->
            <div class="md:col-span-7 lg:col-span-8 space-y-6">
                
                <!-- LINKS TAB -->
                <div v-show="currentTab === 'links'" class="space-y-6">
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-4">Profilo</h2>
                        <div class="space-y-4">
                            <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-2xl border border-gray-200">
                                <img :src="profile.image ? (profile.image.startsWith('http') || profile.image.startsWith('data:') ? profile.image : '/' + profile.image) : ''" class="w-16 h-16 rounded-full object-cover shadow border border-white shrink-0">
                                <div class="flex-1 min-w-0">
                                    <label class="block text-xs font-bold text-gray-600 mb-1">Foto Profilo</label>
                                    <div class="flex gap-2">
                                        <input v-model="profile.image" @input="debouncedUpdatePreview" type="text" class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded-lg text-xs min-w-0" placeholder="URL o percorso immagine">
                                        <label class="px-3 py-2 bg-black hover:bg-gray-800 text-white font-semibold rounded-lg text-xs cursor-pointer transition-colors shrink-0 flex items-center gap-1 shadow-sm">
                                            <span>Carica Foto</span>
                                            <input type="file" accept="image/*" class="hidden" @change="e => uploadFile(e, url => profile.image = url)">
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Nome Profilo</label>
                                <input v-model="profile.name" @input="debouncedUpdatePreview" type="text" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black transition-all">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Bio / Descrizione</label>
                                <input v-model="profile.description" @input="debouncedUpdatePreview" type="text" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black transition-all" placeholder="Scrivi qualcosa su di te...">
                            </div>

                            <div class="border-t border-gray-200 pt-5 mt-5">
                                <h3 class="text-sm font-bold mb-3 flex items-center gap-2 text-gray-800">
                                    <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                    <span>Pulsante Business Mail / Partnership</span>
                                </h3>
                                <div class="space-y-3 bg-gray-50 p-4 rounded-2xl border border-gray-200">
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-600 mb-1">Indirizzo Email Business</label>
                                        <input v-model="profile.businessMail" @input="debouncedUpdatePreview" type="email" class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm" placeholder="es. partnership@valore.it (lascia vuoto per nascondere)">
                                    </div>
                                    <div v-if="profile.businessMail" class="space-y-3 pt-2">
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Testo Pulsante</label>
                                            <input v-model="profile.businessMailTitle" @input="debouncedUpdatePreview" type="text" class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm" placeholder="Contatto Business / Partnership">
                                        </div>
                                        <div class="grid grid-cols-2 gap-3">
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Colore Sfondo</label>
                                                <div class="flex items-center gap-2">
                                                    <input v-model="profile.businessMailColor" @input="debouncedUpdatePreview" type="color" class="w-8 h-8 rounded border-0 cursor-pointer">
                                                    <input v-model="profile.businessMailColor" @input="debouncedUpdatePreview" type="text" class="flex-1 px-2.5 py-1.5 bg-white border border-gray-200 rounded-lg text-xs uppercase" placeholder="rgba(...) o hex">
                                                </div>
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Colore Testo</label>
                                                <div class="flex items-center gap-2">
                                                    <input v-model="profile.businessMailTextColor" @input="debouncedUpdatePreview" type="color" class="w-8 h-8 rounded border-0 cursor-pointer">
                                                    <input v-model="profile.businessMailTextColor" @input="debouncedUpdatePreview" type="text" class="flex-1 px-2.5 py-1.5 bg-white border border-gray-200 rounded-lg text-xs uppercase" placeholder="#ffffff">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4">
                            <h2 class="text-lg font-bold">I tuoi Link <span class="text-xs font-normal text-gray-400 ml-1">(Trascina per ordinare)</span></h2>
                            <button @click="addLink" class="w-full sm:w-auto px-6 py-3 text-sm font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors shadow-sm text-center">
                                + Aggiungi Link
                            </button>
                        </div>

                        <div class="space-y-4" ref="linksList">
                            <div v-for="(link, index) in links" :key="link.id" class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex gap-3 transition-all relative group hover:border-gray-300">
                                
                                <!-- Move & Drag handle -->
                                <div class="flex flex-col justify-center items-center gap-1 text-gray-400">
                                    <div class="drag-handle p-1.5 hover:text-black hover:bg-gray-100 rounded-lg transition-colors cursor-grab active:cursor-grabbing" title="Trascina per spostare">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>
                                    </div>
                                </div>

                                <!-- Link form -->
                                <div class="flex-1 space-y-3 min-w-0">
                                    <div class="flex gap-3">
                                        <div class="flex-1">
                                            <input v-model="link.title" @input="debouncedUpdatePreview" placeholder="Titolo Link" class="w-full px-3 py-2 bg-transparent border-b border-transparent focus:border-purple-500 rounded-none text-md font-bold focus:outline-none transition-colors">
                                        </div>
                                        <button @click="removeLink(index)" class="text-gray-400 hover:text-red-500 p-2 transition-colors shrink-0" title="Elimina link">
                                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        </button>
                                    </div>
                                    <div>
                                        <input v-model="link.url" @input="debouncedUpdatePreview" placeholder="URL (es. https://...)" class="w-full px-3 py-2 bg-transparent border-b border-transparent focus:border-gray-400 rounded-none text-sm text-gray-600 focus:outline-none transition-colors">
                                    </div>
                                    <div class="pt-1">
                                        <label class="block text-[11px] font-bold text-gray-500 mb-1">Nome Profilo / Sottotitolo (es. @rarestvalore)</label>
                                        <div class="flex gap-2">
                                            <input v-model="link.subtitle" @input="debouncedUpdatePreview" placeholder="Lascia vuoto per rilevamento automatico dal social/link" class="flex-1 px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-xs text-gray-600 focus:outline-none focus:ring-1 focus:ring-purple-500">
                                            <button @click="fetchLinkMeta(link)" type="button" class="px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold rounded-lg text-xs transition-colors shrink-0 flex items-center gap-1" title="Rileva nome utente in automatico">
                                                <span>✨ Auto-rileva</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="pt-1">
                                        <label class="block text-[11px] font-bold text-gray-500 mb-1">Immagine / Miniatura Link</label>
                                        <div class="flex gap-2">
                                            <input v-model="link.thumbnail" @input="debouncedUpdatePreview" placeholder="URL Immagine o carica foto" class="flex-1 px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-xs text-gray-600 focus:outline-none focus:ring-1 focus:ring-purple-500">
                                            <label class="px-3 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg text-xs cursor-pointer transition-colors shrink-0 flex items-center gap-1">
                                                <span>Carica Foto</span>
                                                <input type="file" accept="image/*" class="hidden" @change="e => uploadFile(e, url => link.thumbnail = url)">
                                            </label>
                                        </div>
                                    </div>
                                    <div class="pt-2 flex items-center justify-between border-t border-gray-100">
                                        <div class="flex items-center gap-2">
                                            <svg width="16" height="16" fill="currentColor" class="text-yellow-500" viewBox="0 0 16 16"><path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/></svg>
                                            <span class="text-xs font-semibold text-gray-600">In Evidenza (Stile Scheda Grande)</span>
                                        </div>
                                        <div class="relative inline-block w-10 mr-2 align-middle select-none transition duration-200 ease-in">
                                            <input type="checkbox" v-model="link.featured" @change="debouncedUpdatePreview" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer transition-all border-gray-300"/>
                                            <label class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer transition-all"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SOCIALS TAB -->
                <div v-show="currentTab === 'socials'" class="space-y-6">
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h2 class="text-lg font-bold">Social Links</h2>
                                <p class="text-xs text-gray-500 mt-0.5">Aggiungi icone social sotto l'intestazione del profilo</p>
                            </div>
                            <button @click="addSocial" class="px-4 py-2 bg-black hover:bg-gray-800 text-white font-semibold rounded-full text-sm transition-colors shadow-sm flex items-center gap-2">
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Aggiungi Social
                            </button>
                        </div>

                        <div v-if="!socials || socials.length === 0" class="text-center py-8 text-gray-400 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
                            Nessun social link presente. Clicca "Aggiungi Social" per crearne uno.
                        </div>

                        <div v-else class="space-y-4" ref="socialsList">
                            <div v-for="(social, index) in socials" :key="social.id" class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex gap-3 transition-all relative group hover:border-gray-300">
                                <!-- Move & Drag handle -->
                                <div class="flex flex-col justify-center items-center gap-1 text-gray-400">
                                    <div class="drag-handle p-1.5 hover:text-black hover:bg-gray-100 rounded-lg transition-colors cursor-grab active:cursor-grabbing" title="Trascina per spostare">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>
                                    </div>
                                </div>

                                <!-- Social form -->
                                <div class="flex-1 space-y-3 min-w-0">
                                    <div class="flex gap-3">
                                        <div class="w-1/3 min-w-[120px]">
                                            <label class="block text-xs font-semibold text-gray-500 mb-1">Piattaforma</label>
                                            <select v-model="social.platform" @change="debouncedUpdatePreview" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 font-semibold focus:outline-none focus:ring-1 focus:ring-purple-500">
                                                <option value="instagram">Instagram</option>
                                                <option value="tiktok">TikTok</option>
                                                <option value="youtube">YouTube</option>
                                                <option value="spotify">Spotify</option>
                                                <option value="x">X / Twitter</option>
                                                <option value="facebook">Facebook</option>
                                                <option value="linkedin">LinkedIn</option>
                                                <option value="github">GitHub</option>
                                                <option value="discord">Discord</option>
                                                <option value="telegram">Telegram</option>
                                                <option value="whatsapp">WhatsApp</option>
                                                <option value="twitch">Twitch</option>
                                                <option value="soundcloud">SoundCloud</option>
                                                <option value="apple">Apple Music</option>
                                                <option value="amazon">Amazon Music</option>
                                                <option value="custom">Personalizzato (Icona personalizzata)</option>
                                            </select>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <label class="block text-xs font-semibold text-gray-500 mb-1">URL Profilo</label>
                                            <input v-model="social.url" @input="debouncedUpdatePreview" placeholder="https://..." class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-purple-500">
                                        </div>
                                        <div class="flex items-end">
                                            <button @click="removeSocial(index)" class="text-gray-400 hover:text-red-500 p-2 transition-colors shrink-0" title="Elimina social">
                                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div v-if="social.platform === 'custom'" class="pt-2 border-t border-gray-100">
                                        <label class="block text-xs font-semibold text-gray-500 mb-1">Icona Personalizzata (16x16 o 32x32)</label>
                                        <div class="flex gap-2">
                                            <input v-model="social.icon" @input="debouncedUpdatePreview" placeholder="https://... o carica foto" class="flex-1 px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-xs text-gray-600 focus:outline-none focus:ring-1 focus:ring-purple-500">
                                            <label class="px-3 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg text-xs cursor-pointer transition-colors shrink-0 flex items-center gap-1">
                                                <span>Carica Icona</span>
                                                <input type="file" accept="image/*" class="hidden" @change="e => uploadFile(e, url => social.icon = url)">
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- APPEARANCE TAB -->
                <div v-show="currentTab === 'appearance'" class="space-y-6">
                    
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-6">Sfondo</h2>
                        
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div @click="theme.bgType = 'solid'; debouncedUpdatePreview()" :class="theme.bgType !== 'gradient' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-4 text-center hover:bg-gray-50 transition-all">
                                <div class="w-full h-16 rounded-lg bg-gray-200 mb-2"></div>
                                <span class="text-sm font-semibold">Tinta Unita</span>
                            </div>
                            <div @click="theme.bgType = 'gradient'; debouncedUpdatePreview()" :class="theme.bgType === 'gradient' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-4 text-center hover:bg-gray-50 transition-all">
                                <div class="w-full h-16 rounded-lg bg-gradient-to-b from-gray-300 to-gray-500 mb-2"></div>
                                <span class="text-sm font-semibold">Sfumatura</span>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Colore Primario</label>
                                <div class="flex items-center gap-3">
                                    <input v-model="theme.bgColor1" @input="debouncedUpdatePreview" type="color" class="w-10 h-10 rounded border-0 cursor-pointer">
                                    <input v-model="theme.bgColor1" @input="debouncedUpdatePreview" type="text" class="flex-1 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm uppercase">
                                </div>
                            </div>
                            <div v-if="theme.bgType === 'gradient'">
                                <label class="block text-sm font-medium text-gray-600 mb-1">Colore Secondario</label>
                                <div class="flex items-center gap-3 mb-4">
                                    <input v-model="theme.bgColor2" @input="debouncedUpdatePreview" type="color" class="w-10 h-10 rounded border-0 cursor-pointer">
                                    <input v-model="theme.bgColor2" @input="debouncedUpdatePreview" type="text" class="flex-1 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm uppercase">
                                </div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Direzione Sfumatura</label>
                                <select v-model="theme.gradientDirection" @change="debouncedUpdatePreview" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
                                    <option value="to bottom">Dall'alto verso il basso (↓)</option>
                                    <option value="to right">Da sinistra a destra (→)</option>
                                    <option value="to left">Da destra a sinistra (←)</option>
                                    <option value="to top">Dal basso verso l'alto (↑)</option>
                                    <option value="radial">Dal centro all'esterno (Circolare / Radiale)</option>
                                    <option value="135deg">Diagonale (in alto a sx → in basso a dx)</option>
                                    <option value="225deg">Diagonale (in alto a dx → in basso a sx)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-4">Dimensione Icone Social</h2>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div @click="theme.socialIconSize = '20px'; debouncedUpdatePreview()" :class="theme.socialIconSize === '20px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Piccole (20px)</span>
                            </div>
                            <div @click="theme.socialIconSize = '26px'; debouncedUpdatePreview()" :class="!theme.socialIconSize || theme.socialIconSize === '26px' || theme.socialIconSize === '28px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Medie (26px)</span>
                            </div>
                            <div @click="theme.socialIconSize = '32px'; debouncedUpdatePreview()" :class="theme.socialIconSize === '32px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Grandi (32px)</span>
                            </div>
                            <div @click="theme.socialIconSize = '40px'; debouncedUpdatePreview()" :class="theme.socialIconSize === '40px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Max (40px)</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-6">Pulsanti</h2>
                        
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
                            <div @click="theme.btnRadius = '0px'; debouncedUpdatePreview()" :class="theme.btnRadius === '0px' || theme.btnRadius === '0' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <div class="w-16 h-8 bg-black mb-2"></div>
                                <span class="text-xs font-semibold">Squadrati</span>
                            </div>
                            <div @click="theme.btnRadius = '8px'; debouncedUpdatePreview()" :class="theme.btnRadius === '8px' || theme.btnRadius === '8' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <div class="w-16 h-8 bg-black rounded-lg mb-2"></div>
                                <span class="text-xs font-semibold">Smussati</span>
                            </div>
                            <div @click="theme.btnRadius = '50px'; debouncedUpdatePreview()" :class="theme.btnRadius === '50px' || theme.btnRadius === '24px' || theme.btnRadius === '24' || theme.btnRadius === '9999px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <div class="w-16 h-8 bg-black rounded-full mb-2"></div>
                                <span class="text-xs font-semibold">Arrotondati</span>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Stile Pulsante</label>
                                <select v-model="theme.btnBg" @change="debouncedUpdatePreview" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
                                    <option value="transparent">Outline (Bordo sottile)</option>
                                    <option value="#ffffff">Bianco Solido</option>
                                    <option value="#000000">Nero Solido</option>
                                    <option value="#ea73e6">Rosa Valore</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Colore Testo Pulsante</label>
                                <div class="flex items-center gap-3">
                                    <input v-model="theme.btnText" @input="debouncedUpdatePreview" type="color" class="w-10 h-10 rounded border-0 cursor-pointer">
                                    <input v-model="theme.btnText" @input="debouncedUpdatePreview" type="text" class="flex-1 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm uppercase">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-6">Testo</h2>
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Colore Testo Pagina</label>
                            <div class="flex items-center gap-3">
                                <input v-model="theme.fontColor" @input="debouncedUpdatePreview" type="color" class="w-10 h-10 rounded border-0 cursor-pointer">
                                <input v-model="theme.fontColor" @input="debouncedUpdatePreview" type="text" class="flex-1 px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm uppercase">
                            </div>
                        </div>
                    </div>

                </div>

                <!-- STATISTICHE TAB -->
                <div v-show="currentTab === 'stats'" class="space-y-6">
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-xl font-bold mb-6">Panoramica</h2>
                        <div class="grid grid-cols-2 gap-4 mb-6">
                            <div class="p-6 bg-purple-50 rounded-2xl border border-purple-100 text-center">
                                <p class="text-sm text-purple-600 font-semibold mb-1">Visite Totali</p>
                                <p class="text-4xl font-black text-purple-900"><%= stats ? stats.totalVisits : 0 %></p>
                            </div>
                            <div class="p-6 bg-blue-50 rounded-2xl border border-blue-100 text-center">
                                <p class="text-sm text-blue-600 font-semibold mb-1">Click Totali</p>
                                <p class="text-4xl font-black text-blue-900"><%= stats ? stats.totalClicks : 0 %></p>
                            </div>
                        </div>

                        <h3 class="text-lg font-bold mb-4">Click sui Link (Top 10)</h3>
                        <div class="space-y-3">
                            <% if (!stats || stats.topLinks.length === 0) { %>
                                <p class="text-gray-500 text-sm italic">Nessun click registrato ancora.</p>
                            <% } else { %>
                                <% stats.topLinks.forEach(link => { %>
                                <div class="flex justify-between items-center p-4 bg-gray-50 rounded-xl border border-gray-100">
                                    <div class="truncate max-w-[75%]">
                                        <p class="text-sm font-bold text-gray-800 truncate"><%= link.title || link.url %></p>
                                        <p class="text-[11px] font-normal text-gray-400 truncate mt-0.5"><%= link.url %></p>
                                    </div>
                                    <span class="px-3 py-1 bg-black text-white text-xs font-bold rounded-full shrink-0 ml-2"><%= link.count %></span>
                                </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Live Preview -->
            <div :class="showMobilePreview ? 'fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4' : 'hidden md:block md:col-span-5 lg:col-span-4'">
                <div class="sticky top-24 border-[8px] border-black rounded-[3rem] overflow-hidden shadow-2xl h-[700px] w-full max-w-[340px] mx-auto flex flex-col relative transition-all" :class="showMobilePreview ? 'scale-100' : ''">
                    <div class="absolute top-0 inset-x-0 h-6 bg-black z-20 flex justify-center rounded-b-xl w-32 mx-auto"></div>
                    <iframe id="preview-frame" src="/preview" class="w-full h-full border-0 bg-white z-10"></iframe>
                    
                    <button v-if="showMobilePreview" @click="showMobilePreview = false" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black text-white px-4 py-2 rounded-full text-sm z-30">Chiudi</button>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        const initialData = <%- JSON.stringify(data) %>;
        
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    currentTab: 'links',
                    showMobilePreview: false,
                    profile: initialData.profile,
                    theme: initialData.theme || {
                        bgType: 'gradient', gradientDirection: 'to bottom', bgColor1: '#0B152C', bgColor2: '#4E769B',
                        fontColor: '#ffffff', btnBg: 'transparent', btnText: '#fce7ff', btnRadius: '0px'
                    },
                    links: initialData.links,
                    socials: initialData.socials || [],
                    saving: false,
                    previewTimeout: null
                }
            },
            mounted() {
                this.$nextTick(() => {
                    if (this.$refs.linksList) {
                        Sortable.create(this.$refs.linksList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.links.splice(evt.oldIndex, 1)[0];
                                this.links.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                    if (this.$refs.socialsList) {
                        Sortable.create(this.$refs.socialsList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.socials.splice(evt.oldIndex, 1)[0];
                                this.socials.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                });
            },
            methods: {
                async uploadFile(event, callback) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = async (e) => {
                        const base64 = e.target.result;
                        try {
                            const res = await fetch('/admin/upload-image', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ imageBase64: base64, filename: file.name })
                            });
                            const data = await res.json();
                            if (data.success) {
                                callback(data.url);
                                this.debouncedUpdatePreview();
                            } else {
                                alert('Errore caricamento: ' + (data.error || 'sconosciuto'));
                            }
                        } catch (err) {
                            alert('Errore di rete durante il caricamento');
                        }
                    };
                    reader.readAsDataURL(file);
                },
                addSocial() {
                    this.socials.push({
                        id: Date.now().toString(),
                        platform: 'instagram',
                        url: 'https://instagram.com/',
                        icon: ''
                    });
                    this.debouncedUpdatePreview();
                },
                removeSocial(index) {
                    if(confirm('Sei sicuro di voler eliminare questo social?')) {
                        this.socials.splice(index, 1);
                        this.debouncedUpdatePreview();
                    }
                },
                moveUpSocial(index) {
                    if (index > 0) {
                        const temp = this.socials[index];
                        this.socials[index] = this.socials[index - 1];
                        this.socials[index - 1] = temp;
                        this.debouncedUpdatePreview();
                    }
                },
                moveDownSocial(index) {
                    if (index < this.socials.length - 1) {
                        const temp = this.socials[index];
                        this.socials[index] = this.socials[index + 1];
                        this.socials[index + 1] = temp;
                        this.debouncedUpdatePreview();
                    }
                },
                addLink() {
                    this.links.unshift({
                        id: Date.now().toString(),
                        title: 'Nuovo Link',
                        url: 'https://',
                        subtitle: '',
                        featured: false,
                        thumbnail: ''
                    });
                    this.debouncedUpdatePreview();
                },
                async fetchLinkMeta(link) {
                    if (!link.url || link.url === 'https://') return alert("Inserisci prima un URL valido.");
                    // 1. Try regex parsing locally first
                    let detected = null;
                    const url = link.url.trim();
                    const igMatch = url.match(/instagram\.com\/([^/?#]+)/i);
                    if (igMatch && igMatch[1] && !['www', 'p', 'reel', 'reels', 'explore', 'stories'].includes(igMatch[1].toLowerCase())) detected = '@' + igMatch[1];
                    const tkMatch = url.match(/tiktok\.com\/@?([^/?#]+)/i);
                    if (!detected && tkMatch && tkMatch[1] && !['video', 'foryou', 'explore', 'live'].includes(tkMatch[1].toLowerCase())) detected = '@' + tkMatch[1].replace(/^@/, '');
                    const ytMatch = url.match(/youtube\.com\/@([^/?#]+)/i);
                    if (!detected && ytMatch && ytMatch[1]) detected = '@' + ytMatch[1];
                    const xMatch = url.match(/(?:twitter|x)\.com\/([^/?#]+)/i);
                    if (!detected && xMatch && xMatch[1] && !['home', 'explore', 'search', 'messages', 'notifications'].includes(xMatch[1].toLowerCase())) detected = '@' + xMatch[1];
                    
                    if (detected) {
                        link.subtitle = detected;
                        this.debouncedUpdatePreview();
                        return;
                    }
                    
                    // 2. If not detected via regex, call backend API
                    try {
                        const res = await fetch('/admin/fetch-url-meta', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ url: link.url })
                        });
                        const data = await res.json();
                        if (data && data.username) {
                            link.subtitle = data.username;
                        } else if (data && data.title) {
                            link.subtitle = data.title;
                        } else {
                            link.subtitle = this.profile.name || "Valore";
                        }
                        this.debouncedUpdatePreview();
                    } catch (err) {
                        console.error("Errore nel recupero dati:", err);
                        alert("Impossibile recuperare il nome utente in automatico. Puoi scriverlo manualmente.");
                    }
                },
                removeLink(index) {
                    if(confirm('Sei sicuro di voler eliminare questo link?')) {
                        this.links.splice(index, 1);
                        this.debouncedUpdatePreview();
                    }
                },
                moveUp(index) {
                    if (index > 0) {
                        const temp = this.links[index];
                        this.links[index] = this.links[index - 1];
                        this.links[index - 1] = temp;
                        this.debouncedUpdatePreview();
                    }
                },
                moveDown(index) {
                    if (index < this.links.length - 1) {
                        const temp = this.links[index];
                        this.links[index] = this.links[index + 1];
                        this.links[index + 1] = temp;
                        this.debouncedUpdatePreview();
                    }
                },
                debouncedUpdatePreview() {
                    clearTimeout(this.previewTimeout);
                    this.previewTimeout = setTimeout(() => {
                        this.updatePreview();
                    }, 500); // Wait 500ms after last typing before updating
                },
                async updatePreview() {
                    try {
                        const res = await fetch('/admin/preview', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                profile: this.profile,
                                theme: this.theme,
                                links: this.links,
                                socials: this.socials
                            })
                        });
                        if (res.ok) {
                            const iframe = document.getElementById('preview-frame');
                            iframe.contentWindow.location.reload();
                        }
                    } catch (e) {
                        console.error('Preview update failed', e);
                    }
                },
                async save() {
                    this.saving = true;
                    try {
                        const res = await fetch('/admin/update', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                profile: this.profile,
                                theme: this.theme,
                                links: this.links,
                                socials: this.socials
                            })
                        });
                        if (res.ok) {
                            alert('Modifiche pubblicate con successo!');
                        } else {
                            alert('Errore nel salvataggio');
                        }
                    } catch (e) {
                        alert('Errore di connessione');
                    }
                    this.saving = false;
                }
            }
        }).mount('#app');
    </script>
</body>
</html>
