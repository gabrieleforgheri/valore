                    <!-- Ordine Sezioni Drag & Drop -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-2">Ordine Sezioni</h2>
                        <p class="text-sm text-gray-500 mb-6">Trascina le sezioni (drag and drop) o usa le frecce per stabilire l'ordine dei blocchi nella pagina.</p>
                        
                        <div class="space-y-3" ref="sectionsList">
                            <div v-for="(sec, index) in (profile.sectionOrder && profile.sectionOrder.length ? profile.sectionOrder : ['profile', 'socials', 'business_mail', 'links'])" :key="sec" class="bg-gray-50 p-4 rounded-2xl border border-gray-200 flex flex-col shadow-sm hover:border-black transition-all">
                                <div class="flex items-center justify-between cursor-move">
                                    <div class="flex items-center gap-3">
                                        <div class="drag-handle p-2 text-gray-400 hover:text-black cursor-grab">
                                            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-8a2 2 0 1 0-.001-4.001A2 2 0 0 0 13 6zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"></path></svg>
                                        </div>
                                        <span class="font-bold text-sm text-gray-800">
                                            {{ sec === 'profile' ? 'Foto profilo, Nome e Bio' :
                                               sec === 'socials' ? 'Icone Social' :
                                               sec === 'business_mail' ? 'Pulsante Business Email' :
                                               sec === 'links' ? 'Elenco dei Link e Box in evidenza' : sec }}
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <button @click="moveSectionUp(index)" :disabled="index === 0" class="p-1.5 text-gray-400 hover:text-black disabled:opacity-30" title="Sposta su">
                                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                                        </button>
                                        <button @click="moveSectionDown(index)" :disabled="index === (profile.sectionOrder ? profile.sectionOrder.length - 1 : 3)" class="p-1.5 text-gray-400 hover:text-black disabled:opacity-30" title="Sposta giù">
                                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </button>
                                    </div>
                                </div>
                                <div v-if="index < (profile.sectionOrder ? profile.sectionOrder.length - 1 : 3)" class="mt-3 pt-3 border-t border-gray-200 flex items-center justify-between cursor-default">
                                    <label class="text-xs font-bold text-gray-600">Distanza sotto questa sezione</label>
                                    <div class="flex gap-2 items-center w-[55%]">
                                        <input type="range" min="0" max="64" step="2" v-model.number="profile.sectionGaps[sec]" @input="debouncedUpdatePreview" class="flex-1 accent-black cursor-pointer">
                                        <input type="number" min="0" max="100" v-model.number="profile.sectionGaps[sec]" @input="debouncedUpdatePreview" class="w-14 p-1 bg-white border border-gray-200 rounded text-xs font-bold text-center">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Live Preview -->
            <div :class="showMobilePreview ? 'fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4' : 'hidden md:block w-full md:w-[45%] lg:w-[40%] xl:w-[35%] sticky top-20'">
                <div class="border-[8px] border-black rounded-[3rem] overflow-hidden shadow-2xl h-[700px] w-full max-w-[340px] mx-auto flex flex-col relative transition-all" :class="showMobilePreview ? 'scale-100' : ''">
                    <div class="absolute top-0 inset-x-0 h-6 bg-black z-20 flex justify-center rounded-b-xl w-32 mx-auto"></div>
                    <iframe id="preview-frame" src="/preview" class="w-full h-full border-0 bg-white z-10"></iframe>
                    
                    <button v-if="showMobilePreview" @click="showMobilePreview = false" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black text-white px-4 py-2 rounded-full text-sm z-30">Chiudi</button>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        const initialData = <%- JSON.stringify(data) %>;
        const initialStats = <%- JSON.stringify(stats) %>;
        
        const { createApp } = Vue;

        if (!initialData.profile.sectionOrder || !Array.isArray(initialData.profile.sectionOrder) || initialData.profile.sectionOrder.length === 0) {
            initialData.profile.sectionOrder = ['profile', 'socials', 'business_mail', 'links'];
        }
        if (!initialData.profile.sectionGaps) initialData.profile.sectionGaps = {};
        const oldGap = initialData.profile.sectionGap !== undefined ? initialData.profile.sectionGap : 16;
        ['profile', 'socials', 'business_mail', 'links'].forEach(s => {
            if (initialData.profile.sectionGaps[s] === undefined) initialData.profile.sectionGaps[s] = oldGap;
        });
        if (initialData.profile.linkGap === undefined) initialData.profile.linkGap = 14;
        if (initialData.profile.paddingTop === undefined) initialData.profile.paddingTop = 24;
        if (initialData.profile.paddingBottom === undefined) initialData.profile.paddingBottom = 32;

        if (initialData.links && Array.isArray(initialData.links)) {
            initialData.links.forEach(l => {
                if (!l.iconChoice) l.iconChoice = l.customIcon ? 'custom' : 'auto';
            });
        }

        createApp({
            data() {
                const initialLinkGap = initialData.profile.linkGap !== undefined ? initialData.profile.linkGap : 14;
                const startDate = new Date(Date.now() - 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
                const endDate = new Date().toISOString().split('T')[0];
                return {
                    currentTab: 'links',
                    showMobilePreview: false,
                    profile: initialData.profile,
                    theme: initialData.theme || {
                        bgType: 'gradient', gradientDirection: 'to bottom', bgColor1: '#0B152C', bgColor2: '#4E769B',
                        fontColor: '#ffffff', btnBg: 'transparent', btnText: '#fce7ff', btnRadius: '0px'
                    },
                    links: initialData.links,
                    socials: initialData.socials || [],
                    stats: initialStats || { totalVisits: 0, totalClicks: 0, socialClicks: [], linkClicks: [] },
                    saving: false,
                    previewTimeout: null,
                    linkGapPreset: [8, 12, 16, 24].includes(initialLinkGap) ? String(initialLinkGap) : 'custom',
                    chartStartDate: startDate,
                    chartEndDate: endDate,
                    chartInstance: null,
                    detailedChartData: [],
                    _statsInterval: null
                }
            },
            mounted() {
                this.$nextTick(() => {
                    if (this.$refs.linksList) {
                        Sortable.create(this.$refs.linksList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.links.splice(evt.oldIndex, 1)[0];
                                this.links.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                    if (this.$refs.socialsList) {
                        Sortable.create(this.$refs.socialsList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.socials.splice(evt.oldIndex, 1)[0];
                                this.socials.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                    if (this.$refs.sectionsList) {
                        Sortable.create(this.$refs.sectionsList, {
                            handle: '.drag-handle',
                            animation: 150,
                            onEnd: (evt) => {
                                const item = this.profile.sectionOrder.splice(evt.oldIndex, 1)[0];
                                this.profile.sectionOrder.splice(evt.newIndex, 0, item);
                                this.debouncedUpdatePreview();
                            }
                        });
                    }
                });
            },
            watch: {
                currentTab(newTab, oldTab) {
                    if (newTab !== 'stats' && this._statsInterval) {
                        clearInterval(this._statsInterval);
                        this._statsInterval = null;
                    }
                }
            },
            beforeUnmount() {
                if (this._statsInterval) {
                    clearInterval(this._statsInterval);
                    this._statsInterval = null;
                }
            },
            methods: {
                initChart() {
                    this.$nextTick(async () => {
                        await this.fetchChartData();
                        await this.fetchLiveStats();
                        // Start real-time polling (every 5s)
                        if (this._statsInterval) clearInterval(this._statsInterval);
                        this._statsInterval = setInterval(() => {
                            this.fetchLiveStats();
                            this.fetchChartData();
                        }, 5000);
                    });
                },
                async fetchLiveStats() {
                    try {
                        const res = await fetch('/admin/api/stats');
                        const data = await res.json();
                        if (data.success) {
                            this.stats.totalVisits = data.totalVisits;
                            this.stats.totalClicks = data.totalClicks;
                            this.stats.socialClicks = data.socialClicks;
                            this.stats.linkClicks = data.linkClicks;
                        }
                    } catch(e) {
                        console.error('Error fetching live stats:', e);
                    }
                },
                async fetchChartData() {
                    const start = new Date(this.chartStartDate);
                    const end = new Date(this.chartEndDate);
                    const diffDays = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
                    
                    if (diffDays > 31) {
                        alert("L'intervallo di date massimo selezionabile per il grafico è di 31 giorni (1 mese).");
                        const maxStart = new Date(end.getTime() - 30 * 24 * 60 * 60 * 1000);
                        this.chartStartDate = maxStart.toISOString().split('T')[0];
                    }
                    
                    try {
                        const res = await fetch(`/admin/api/analytics?startDate=${this.chartStartDate}&endDate=${this.chartEndDate}`);
                        const data = await res.json();
                        if (data.success) {
                            this.detailedChartData = data.detailedClicks || [];
                            this.renderChart(data.dailyClicks || []);
                        }
                    } catch(e) {
                        console.error('Error fetching chart data:', e);
                    }
                },
                renderChart(dailyClicks) {
                    const ctx = document.getElementById('clicksChart');
                    if (!ctx) return;
                    
                    const labels = dailyClicks.map(d => d.date);
                    const counts = dailyClicks.map(d => d.count);
                    
                    if (this.chartInstance) {
                        this.chartInstance.destroy();
                    }
                    
                    this.chartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels.length ? labels : [this.chartStartDate],
                            datasets: [{
                                label: 'Clic Giornalieri',
                                data: counts.length ? counts : [0],
                                borderColor: '#9333ea',
                                backgroundColor: 'rgba(147, 51, 234, 0.1)',
                                fill: true,
                                tension: 0.3,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#9333ea'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: { precision: 0 }
                                }
                            }
                        }
                    });
                },
                exportCSV() {
                    if (!this.detailedChartData || this.detailedChartData.length === 0) {
                        alert("Nessun dato disponibile nel periodo selezionato per l'esportazione.");
                        return;
                    }
                    
                    let csv = "Data;Titolo Link / Social;URL;Clic\n";
                    this.detailedChartData.forEach(row => {
                        const date = row.date || '';
                        const title = (row.linkTitle || '').replace(/;/g, ',');
                        const url = (row.linkUrl || '').replace(/;/g, ',');
                        const count = row.count || 0;
                        csv += `"${date}";"${title}";"${url}";${count}\n`;
                    });
                    
                    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `analytics_report_${this.chartStartDate}_to_${this.chartEndDate}.csv`;
                    a.click();
                    URL.revokeObjectURL(url);
                },
                onLinkGapPresetChange() {
                    if (this.linkGapPreset !== 'custom') {
                        this.profile.linkGap = parseInt(this.linkGapPreset, 10);
                        this.debouncedUpdatePreview();
                    }
                },
                initSectionsSortable() {
                    this.$nextTick(() => {
                        if (this.$refs.sectionsList && !this._sectionsSortableInitialized) {
                            this._sectionsSortableInitialized = true;
                            Sortable.create(this.$refs.sectionsList, {
                                handle: '.drag-handle',
                                animation: 150,
                                onEnd: (evt) => {
                                    const item = this.profile.sectionOrder.splice(evt.oldIndex, 1)[0];
                                    this.profile.sectionOrder.splice(evt.newIndex, 0, item);
                                    this.debouncedUpdatePreview();
                                }
                            });
                        }
                    });
                },
                moveSectionUp(index) {
                    if (index > 0 && this.profile.sectionOrder) {
                        const item = this.profile.sectionOrder.splice(index, 1)[0];
                        this.profile.sectionOrder.splice(index - 1, 0, item);
                        this.profile.sectionOrder = [...this.profile.sectionOrder];
                        this.debouncedUpdatePreview();
                    }
                },
                moveSectionDown(index) {
                    if (this.profile.sectionOrder && index < this.profile.sectionOrder.length - 1) {
                        const item = this.profile.sectionOrder.splice(index, 1)[0];
                        this.profile.sectionOrder.splice(index + 1, 0, item);
                        this.profile.sectionOrder = [...this.profile.sectionOrder];
                        this.debouncedUpdatePreview();
                    }
                },
                async uploadFile(event, callback) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = async (e) => {
                        const base64 = e.target.result;
                        try {
                            const res = await fetch('/admin/upload-image', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ imageBase64: base64, filename: file.name })
                            });
                            const data = await res.json();
                            if (data.success) {
                                callback(data.url);
                                this.debouncedUpdatePreview();
                            } else {
                                alert('Errore caricamento: ' + (data.error || 'sconosciuto'));
                            }
                        } catch (err) {
                            alert('Errore di rete durante il caricamento');
                        }
                    };
                    reader.readAsDataURL(file);
                },
                addSocial() {
                    this.socials.push({
                        id: Date.now().toString(),
                        platform: 'instagram',
                        url: 'https://instagram.com/',
                        icon: ''
                    });
                    this.debouncedUpdatePreview();
                },
                removeSocial(index) {
                    if(confirm('Sei sicuro di voler eliminare questo social?')) {
                        this.socials.splice(index, 1);
                        this.debouncedUpdatePreview();
                    }
                },
                addLink() {
                    this.links.unshift({
                        id: Date.now().toString(),
                        title: 'Nuovo Link',
                        url: 'https://',
                        subtitle: '',
                        featured: false,
                        featuredSize: '3',
                        iconChoice: 'auto',
                        customIcon: '',
                        thumbnail: '',
                        transparent: false,
                        bgColor: ''
                    });
                    this.debouncedUpdatePreview();
                },
                removeLink(index) {
                    if(confirm('Sei sicuro di voler eliminare questo link?')) {
                        this.links.splice(index, 1);
                        this.debouncedUpdatePreview();
                    }
                },
                async fetchLinkMeta(link) {
                    if (!link.url || link.url === 'https://') return alert("Inserisci prima un URL valido.");
                    let detected = null;
                    const url = link.url.trim();
                    const igMatch = url.match(/instagram\.com\/([^/?#]+)/i);
                    if (igMatch && igMatch[1] && !['www', 'p', 'reel', 'reels', 'explore', 'stories'].includes(igMatch[1].toLowerCase())) detected = '@' + igMatch[1];
                    const tkMatch = url.match(/tiktok\.com\/@?([^/?#]+)/i);
                    if (!detected && tkMatch && tkMatch[1] && !['video', 'foryou', 'explore', 'live'].includes(tkMatch[1].toLowerCase())) detected = '@' + tkMatch[1].replace(/^@/, '');
                    const ytMatch = url.match(/youtube\.com\/@([^/?#]+)/i);
                    if (!detected && ytMatch && ytMatch[1]) detected = '@' + ytMatch[1];
                    
                    if (detected) {
                        link.subtitle = detected;
                        this.debouncedUpdatePreview();
                        return;
                    }
                    
                    try {
                        const res = await fetch('/admin/fetch-link-meta', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ url: link.url })
                        });
                        const data = await res.json();
                        if (data.success) {
                            if (data.title && (!link.title || link.title === 'Nuovo Link')) link.title = data.title;
                            if (data.subtitle && !link.subtitle) link.subtitle = data.subtitle;
                            if (data.image && !link.thumbnail) link.thumbnail = data.image;
                            this.debouncedUpdatePreview();
                        } else {
                            alert("Non è stato possibile estrarre dati automatici da questo URL.");
                        }
                    } catch (e) {
                        alert("Errore durante il recupero dei dati.");
                    }
                },
                debouncedUpdatePreview() {
                    clearTimeout(this.previewTimeout);
                    this.previewTimeout = setTimeout(() => {
                        this.updatePreview();
                    }, 250);
                },
                async updatePreview() {
                    try {
                        await fetch('/admin/preview', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                profile: this.profile,
                                links: this.links,
                                socials: this.socials,
                                theme: this.theme
                            })
                        });
                        const iframe = document.getElementById('preview-frame');
                        if (iframe) iframe.src = '/preview?t=' + Date.now();
                    } catch(e) {
                        console.error('Errore update preview:', e);
                    }
                },
                async save() {
                    this.saving = true;
                    try {
                        const res = await fetch('/admin/save', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                profile: this.profile,
                                links: this.links,
                                socials: this.socials,
                                theme: this.theme
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            alert('Modifiche pubblicate con successo!');
                            this.updatePreview();
                        } else {
                            alert('Errore durante il salvataggio: ' + data.error);
                        }
                    } catch(e) {
                        alert('Errore di connessione durante il salvataggio.');
                    } finally {
                        this.saving = false;
                    }
                }
            }
        }).mount('#app');
    </script>
</body>
</html>
