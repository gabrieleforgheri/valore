                                        <option value="24">Ampia (24px)</option>
                                        <option value="custom">Personalizzata...</option>
                                    </select>
                                    <input type="number" min="0" max="64" v-model.number="profile.linkGap" @input="debouncedUpdatePreview" class="w-16 p-2 bg-white border border-gray-200 rounded-xl text-xs font-bold text-center">
                                </div>
                            </div>



                            <!-- Margine dall'Alto (Top) -->
                            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-2.5">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-gray-700">Distanza dall'Alto (Top)</label>
                                    <span class="text-xs font-mono font-bold bg-white px-2 py-0.5 rounded border border-gray-200">{{ profile.paddingTop || 24 }} px</span>
