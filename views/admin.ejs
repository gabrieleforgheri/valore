                                </div>
                                <div class="flex gap-2 items-center">
                                    <input type="range" min="0" max="120" step="4" v-model.number="profile.paddingBottom" @input="debouncedUpdatePreview" class="flex-1 accent-black cursor-pointer">
                                    <input type="number" min="0" max="200" v-model.number="profile.paddingBottom" @input="debouncedUpdatePreview" class="w-16 p-2 bg-white border border-gray-200 rounded-xl text-xs font-bold text-center">
