<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Valore Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background: #f3f4f6; }
        .drag-handle { cursor: grab; }
        .drag-handle:active { cursor: grabbing; }
        .toggle-checkbox:checked { right: 0; border-color: #68D391; }
        .toggle-checkbox:checked + .toggle-label { background-color: #68D391; }
    </style>
</head>
<body class="text-gray-800 font-sans antialiased overflow-x-hidden">
    <div id="app" class="min-h-screen pb-20">
        <!-- Navbar -->
        <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-6xl mx-auto px-4 h-16 flex justify-between items-center">
                <div class="flex items-center gap-6">
                    <img :src="profile.image ? (profile.image.startsWith('http') || profile.image.startsWith('data:') ? profile.image : '/' + profile.image) : '/images/FotoProfiloFinale.png'" class="w-10 h-10 rounded-2xl object-cover shadow-sm border border-gray-100">
                    <div class="hidden sm:flex gap-1">
                        <button @click="currentTab = 'links'" :class="currentTab === 'links' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Links</button>
                        <button @click="currentTab = 'socials'" :class="currentTab === 'socials' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Socials</button>
                        <button @click="currentTab = 'appearance'" :class="currentTab === 'appearance' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Aspetto</button>
                        <button @click="currentTab = 'stats'; initChart()" :class="currentTab === 'stats' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Statistiche</button>
                        <button @click="currentTab = 'sections'; initSectionsSortable()" :class="currentTab === 'sections' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="px-3 py-5 font-semibold text-sm transition-colors">Sezioni</button>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button @click="showMobilePreview = !showMobilePreview" class="md:hidden px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-full">Anteprima</button>
                    <a href="/" target="_blank" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors hidden sm:block">Vedi Sito</a>
                    <button @click="window.location.reload()" class="px-4 py-2 text-sm font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-full transition-colors shadow-sm border border-red-100 flex items-center gap-1">Annulla</button>
                    <button @click="save" class="px-5 py-2 text-sm font-semibold text-white bg-black hover:bg-gray-800 rounded-full transition-colors shadow-md flex items-center gap-2">
                        <span v-if="saving">Salvataggio...</span>
                        <span v-else>Pubblica Modifiche</span>
                    </button>
                </div>
            </div>
            <!-- Mobile Tabs -->
            <div class="sm:hidden flex border-t border-gray-100">
                <button @click="currentTab = 'links'" :class="currentTab === 'links' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Links</button>
                <button @click="currentTab = 'socials'" :class="currentTab === 'socials' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Socials</button>
                <button @click="currentTab = 'appearance'" :class="currentTab === 'appearance' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Aspetto</button>
                <button @click="currentTab = 'stats'; initChart()" :class="currentTab === 'stats' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Statistiche</button>
                <button @click="currentTab = 'sections'; initSectionsSortable()" :class="currentTab === 'sections' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'" class="flex-1 py-3 font-semibold text-sm">Sezioni</button>
            </div>
        </nav>

        <div class="max-w-[1400px] mx-auto px-4 mt-8 flex flex-col md:flex-row gap-8 items-start relative">
            
            <!-- Left Column: Editor -->
            <div class="w-full md:w-[55%] lg:w-[60%] xl:w-[65%] space-y-6">
                
                <!-- LINKS TAB -->
                <div v-show="currentTab === 'links'" class="space-y-6">
                    <!-- Profile Header Block -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-4">Profilo</h2>
                        <div class="space-y-4">
                            <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-2xl border border-gray-200">
                                <img :src="profile.image ? (profile.image.startsWith('http') || profile.image.startsWith('data:') ? profile.image : '/' + profile.image) : ''" class="w-14 h-14 rounded-2xl object-cover shadow border border-white shrink-0">
                                <div class="flex-1 min-w-0">
                                    <label class="block text-xs font-bold text-gray-600 mb-2">Foto Profilo</label>
                                    <div class="flex gap-2">
                                        <label class="px-4 py-2 bg-black hover:bg-gray-800 text-white font-semibold rounded-lg text-xs cursor-pointer transition-colors inline-flex items-center gap-1 shadow-sm">
                                            <span>Carica Nuova Foto</span>
                                            <input type="file" accept="image/*" class="hidden" @change="e => uploadFile(e, url => profile.image = url)">
                                        </label>
                                        <button v-if="profile.image" @click="profile.image = ''; debouncedUpdatePreview()" type="button" class="px-3 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-lg text-xs transition-colors shadow-sm">
                                            Rimuovi
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Nome Profilo</label>
                                <input v-model="profile.name" @input="debouncedUpdatePreview" type="text" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black transition-all">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-1">Bio / Descrizione</label>
                                <input v-model="profile.description" @input="debouncedUpdatePreview" type="text" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black transition-all" placeholder="Scrivi qualcosa su di te...">
                            </div>

                            <div class="border-t border-gray-200 pt-5 mt-5">
                                <h3 class="text-sm font-bold mb-3 flex items-center gap-2 text-gray-800">
                                    <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                    <span>Pulsante Business Mail / Partnership</span>
                                </h3>
                                <div class="space-y-3 bg-gray-50 p-4 rounded-2xl border border-gray-200">
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-600 mb-1">Indirizzo Email Business</label>
                                        <input v-model="profile.businessMail" @input="debouncedUpdatePreview" type="email" class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm" placeholder="es. partnership@valore.it (lascia vuoto per nascondere)">
                                    </div>
                                    <div v-if="profile.businessMail" class="space-y-3 pt-2">
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Testo Pulsante</label>
                                            <input v-model="profile.businessMailTitle" @input="debouncedUpdatePreview" type="text" class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm" placeholder="Contatto Business / Partnership">
                                        </div>
                                        <div class="grid grid-cols-2 gap-3">
                                            <div>
                                                <div class="flex items-center justify-between mb-1">
                                                    <label class="block text-xs font-semibold text-gray-600">Colore Sfondo</label>
                                                    <label class="flex items-center gap-1 cursor-pointer">
                                                        <input type="checkbox" v-model="profile.businessMailTransparent" @change="debouncedUpdatePreview" class="rounded border-gray-300 text-black focus:ring-black w-3.5 h-3.5">
                                                        <span class="text-[10px] font-bold text-purple-600 uppercase">Trasparente</span>
                                                    </label>
                                                </div>
                                                <div v-if="!profile.businessMailTransparent" class="flex items-center gap-2">
                                                    <input v-model="profile.businessMailColor" @input="debouncedUpdatePreview" type="color" class="w-8 h-8 rounded border-0 cursor-pointer">
                                                    <input v-model="profile.businessMailColor" @input="debouncedUpdatePreview" type="text" class="flex-1 px-2.5 py-1.5 bg-white border border-gray-200 rounded-lg text-xs uppercase" placeholder="rgba(...) o hex">
                                                </div>
                                                <div v-else class="px-3 py-2 bg-gray-100 rounded-lg text-xs text-gray-500 italic text-center">
                                                    Sfondo trasparente
                                                </div>
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-600 mb-1">Colore Testo</label>
                                                <div class="flex items-center gap-2">
                                                    <input v-model="profile.businessMailTextColor" @input="debouncedUpdatePreview" type="color" class="w-8 h-8 rounded border-0 cursor-pointer">
                                                    <input v-model="profile.businessMailTextColor" @input="debouncedUpdatePreview" type="text" class="flex-1 px-2.5 py-1.5 bg-white border border-gray-200 rounded-lg text-xs uppercase" placeholder="#ffffff">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Links Management Block (Compact & Minimal) -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h2 class="text-lg font-bold">I tuoi Link</h2>
                                <p class="text-xs text-gray-400">Trascina le schede per riordinare i link</p>
                            </div>
                            <button @click="addLink" class="px-5 py-2.5 text-sm font-semibold text-white bg-purple-600 hover:bg-purple-700 rounded-full transition-colors shadow-sm">
                                + Aggiungi Link
                            </button>
                        </div>

                        <div class="space-y-3" ref="linksList">
                            <div v-for="(link, index) in links" :key="link.id" class="bg-white p-3.5 rounded-2xl border border-gray-200 shadow-sm transition-all relative group hover:border-gray-300 space-y-2.5">
                                
                                <!-- Header Row: Drag, Title, Delete -->
                                <div class="flex items-center gap-2">
                                    <div class="drag-handle p-1 text-gray-400 hover:text-black rounded cursor-grab active:cursor-grabbing shrink-0" title="Trascina per riordinare">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>
                                    </div>
                                    <input v-model="link.title" @input="debouncedUpdatePreview" placeholder="Titolo del Link" class="flex-1 px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold focus:outline-none focus:ring-1 focus:ring-purple-500">
                                    <button @click="removeLink(index)" class="text-gray-400 hover:text-red-500 p-1.5 transition-colors shrink-0" title="Elimina link">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>

                                <!-- URL Field -->
                                <div>
                                    <input v-model="link.url" @input="debouncedUpdatePreview" placeholder="URL destinazione (es. https://...)" class="w-full px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-600 focus:outline-none focus:ring-1 focus:ring-purple-500">
                                </div>

                                <!-- Subtitle Field + Auto-detect -->
                                <div class="flex gap-2 items-center">
                                    <input v-model="link.subtitle" @input="debouncedUpdatePreview" placeholder="Sottotitolo (opzionale)" class="flex-1 px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-600 focus:outline-none focus:ring-1 focus:ring-purple-500">
                                    <button @click="fetchLinkMeta(link)" type="button" class="px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold rounded-xl text-xs transition-colors shrink-0 flex items-center gap-1" title="Rileva dati in automatico">
                                        <span>✨ Auto-rileva</span>
                                    </button>
                                </div>

                                <!-- Horizontal Inline Controls Bar (Ultra-Compact, No Sub-Cards) -->
                                <div class="pt-2 border-t border-gray-100 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
                                    
                                    <!-- Image Action -->
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-semibold text-gray-500">Immagine:</span>
                                        <label class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-xs cursor-pointer transition-colors">
                                            <span>{{ link.thumbnail ? 'Modifica' : 'Carica' }}</span>
                                            <input type="file" accept="image/*" class="hidden" @change="e => uploadFile(e, url => { link.thumbnail = url; debouncedUpdatePreview(); })">
                                        </label>
                                        <button v-if="link.thumbnail" @click="link.thumbnail = ''; debouncedUpdatePreview()" type="button" class="px-2 py-1 bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-lg text-xs transition-colors">
                                            Rimuovi
                                        </button>
                                    </div>

                                    <!-- Icon Choice -->
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-semibold text-gray-500">Icona:</span>
                                        <select v-model="link.iconChoice" @change="debouncedUpdatePreview" class="px-2 py-1 bg-gray-50 border border-gray-200 rounded-lg text-xs font-semibold text-gray-700 focus:outline-none">
                                            <option value="auto">Auto (URL)</option>
                                            <option value="instagram">Instagram</option>
                                            <option value="tiktok">TikTok</option>
                                            <option value="youtube">YouTube</option>
                                            <option value="spotify">Spotify</option>
                                            <option value="x">X / Twitter</option>
                                            <option value="facebook">Facebook</option>
                                            <option value="linkedin">LinkedIn</option>
                                            <option value="github">GitHub</option>
                                            <option value="discord">Discord</option>
                                            <option value="twitch">Twitch</option>
                                            <option value="soundcloud">SoundCloud</option>
                                            <option value="apple">Apple Music</option>
                                            <option value="custom">Personalizzata...</option>
                                        </select>
                                        <template v-if="link.iconChoice === 'custom'">
                                            <input v-model="link.customIcon" @input="debouncedUpdatePreview" placeholder="URL..." class="w-24 px-2 py-1 bg-gray-50 border border-gray-200 rounded text-xs">
                                            <label class="px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded text-xs cursor-pointer shrink-0">
                                                <span>Carica</span>
                                                <input type="file" accept="image/*" class="hidden" @change="e => uploadFile(e, url => { link.customIcon = url; debouncedUpdatePreview(); })">
                                            </label>
                                        </template>
                                    </div>

                                    <!-- Featured Toggle & Size -->
                                    <div class="flex items-center gap-1.5">
                                        <label class="flex items-center gap-1 cursor-pointer">
                                            <input type="checkbox" v-model="link.featured" @change="debouncedUpdatePreview" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500 w-4 h-4 cursor-pointer">
                                            <span class="font-semibold text-gray-700">In Evidenza</span>
                                        </label>
                                        <select v-if="link.featured" v-model="link.featuredSize" @change="debouncedUpdatePreview" class="px-2 py-1 bg-gray-50 border border-gray-200 rounded-lg text-xs font-semibold text-gray-700">
                                            <option value="1">Orizzontale</option>
                                            <option value="2">Banner Medio</option>
                                            <option value="3">Standard (16:9)</option>
                                            <option value="4">Grande (4:3)</option>
                                            <option value="5">Quadrato (1:1)</option>
                                        </select>
                                    </div>

                                    <!-- Transparent Sfondo Toggle & Color -->
                                    <div class="flex items-center gap-1.5">
                                        <label class="flex items-center gap-1 cursor-pointer">
                                            <input type="checkbox" v-model="link.transparent" @change="debouncedUpdatePreview" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500 w-4 h-4 cursor-pointer">
                                            <span class="font-semibold text-gray-700">Trasparente</span>
                                        </label>
                                        <div v-if="!link.transparent" class="flex items-center gap-1">
                                            <input v-model="link.bgColor" @input="debouncedUpdatePreview" type="color" class="w-5 h-5 rounded border-0 cursor-pointer p-0">
                                            <input v-model="link.bgColor" @input="debouncedUpdatePreview" placeholder="#colore" class="w-16 px-1.5 py-0.5 bg-gray-50 border border-gray-200 rounded text-[11px] uppercase">
                                        </div>
                                    </div>

                                </div></div>
                </div>
            </div>
        </div>

                <!-- SOCIALS TAB -->
                <div v-show="currentTab === 'socials'" class="space-y-6">
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <h2 class="text-lg font-bold mb-4">Dimensione Icone Social</h2>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div @click="theme.socialIconSize = '20px'; debouncedUpdatePreview()" :class="theme.socialIconSize === '20px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Piccole (20px)</span>
                            </div>
                            <div @click="theme.socialIconSize = '26px'; debouncedUpdatePreview()" :class="!theme.socialIconSize || theme.socialIconSize === '26px' || theme.socialIconSize === '28px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Medie (26px)</span>
                            </div>
                            <div @click="theme.socialIconSize = '32px'; debouncedUpdatePreview()" :class="theme.socialIconSize === '32px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Grandi (32px)</span>
                            </div>
                            <div @click="theme.socialIconSize = '40px'; debouncedUpdatePreview()" :class="theme.socialIconSize === '40px' ? 'ring-2 ring-black bg-gray-50' : ''" class="cursor-pointer border rounded-xl p-3 text-center hover:bg-gray-50 transition-all flex flex-col items-center">
                                <span class="text-xs font-semibold">Max (40px)</span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
                        <div class="flex justify-between items-center mb-6">
                            <div>
                                <h2 class="text-lg font-bold">Social Links</h2>
                                <p class="text-xs text-gray-500 mt-0.5">Aggiungi icone social sotto l'intestazione del profilo</p>
                            </div>
                            <button @click="addSocial" class="px-4 py-2 bg-black hover:bg-gray-800 text-white font-semibold rounded-full text-sm transition-colors shadow-sm flex items-center gap-2">
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Aggiungi Social
                            </button>
                        </div>

                        <div v-if="!socials || socials.length === 0" class="text-center py-8 text-gray-400 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
                            Nessun social link presente. Clicca "Aggiungi Social" per crearne uno.
                        </div>

                        <div v-else class="space-y-4" ref="socialsList">
                            <div v-for="(social, index) in socials" :key="social.id" class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex gap-3 transition-all relative group hover:border-gray-300">
                                <div class="flex flex-col justify-center items-center gap-1 text-gray-400">
                                    <div class="drag-handle p-1.5 hover:text-black hover:bg-gray-100 rounded-lg transition-colors cursor-grab active:cursor-grabbing" title="Trascina per spostare">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM14 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>
                                    </div>
                                </div>

                                <div class="flex-1 space-y-3 min-w-0">
                                    <div class="flex gap-3">
                                        <div class="w-1/3 min-w-[120px]">
                                            <label class="block text-xs font-semibold text-gray-500 mb-1">Piattaforma</label>
                                            <select v-model="social.platform" @change="debouncedUpdatePreview" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 font-semibold focus:outline-none focus:ring-1 focus:ring-purple-500">
                                                <option value="instagram">Instagram</option>
                                                <option value="tiktok">TikTok</option>
                                                <option value="youtube">YouTube</option>
                                                <option value="spotify">Spotify</option>
                                                <option value="x">X / Twitter</option>
                                                <option value="facebook">Facebook</option>
                                                <option value="linkedin">LinkedIn</option>
                                                <option value="github">GitHub</option>
                                                <option value="discord">Discord</option>
                                                <option value="telegram">Telegram</option>
                                                <option value="whatsapp">WhatsApp</option>
                                                <option value="twitch">Twitch</option>
                                                <option value="soundcloud">SoundCloud</option>
                                                <option value="apple">Apple Music</option>
                                                <option value="amazon">Amazon Music</option>
                                                <option value="custom">Personalizzata...</option>
                                            </select>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <label class="block text-xs font-semibold text-gray-500 mb-1">URL Profilo</label>
