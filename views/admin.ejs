                <!-- SECTIONS TAB -->
                <div v-show="currentTab === 'sections'" class="space-y-6">
                    <!-- Spaziature & Margini Pagina -->
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 space-y-6">
                        <div>
                            <h2 class="text-lg font-bold">Spaziature & Margini Pagina</h2>
                            <p class="text-xs text-gray-400 mt-0.5">Personalizza la distanza tra i link, tra i blocchi e i margini della pagina (in pixel)</p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Distanza tra i Link -->
