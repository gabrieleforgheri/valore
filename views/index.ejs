<% if (typeof isPreview === 'undefined' || !isPreview) { %>
<script>
  let visitId = null;
  let startTime = Date.now();

  // Record visit
  fetch('/api/track/visit', { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if(data.success) visitId = data.visitId;
    }).catch(console.error);

  // Ping time spent every 5 seconds
  setInterval(() => {
    if (visitId) {
      const timeSpent = Math.floor((Date.now() - startTime) / 1000);
      fetch('/api/track/ping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitId, timeSpent })
      }).catch(console.error);
    }
  }, 5000);

  // Track clicks
  document.addEventListener('click', (e) => {
    const a = e.target.closest('a');
    if (a && a.href) {
      let title = a.getAttribute('data-title');
      if (!title) {
        const cont = a.closest('[data-testid="NewLinkContainer"]');
        if (cont) {
          const tEl = cont.querySelector('[data-link-label="true"]');
          if (tEl) title = tEl.innerText.trim();
        }
      }
      if (!title) title = a.innerText.trim() || a.getAttribute('title') || '';
      fetch('/api/track/click', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ linkUrl: a.href, linkTitle: title, visitId })
      }).catch(console.error);
    }
  });
</script>
<% } %>

</body></html>