<style id="dynamic-theme">
  html {
    /* Dynamic theme variables */
    --button-style-text: <%= theme.btnText || '#fce7ff' %>;
    --button-style-background: <%= theme.btnBg || 'transparent' %>;
    --button-style-background-hover: color-mix(in srgb, var(--button-style-background) 93%, #ffffff 7%);
    --button-style-border-color: <%= theme.btnBg === 'transparent' ? (theme.btnText || '#fce7ff') : 'transparent' %>;
    --button-style-border: <%= theme.btnBorderWidth || '1.5px' %> solid <%= theme.btnBorderColor || 'var(--button-style-border-color)' %>;
    --button-style-shadow: <%= theme.btnShadow === 'soft' ? '0 4px 14px rgba(0,0,0,0.15)' : (theme.btnShadow === 'glow' ? '0 0 16px ' + (theme.bgGlow || 'rgba(234,115,230,0.6)') : (theme.btnShadow === 'none' ? 'none' : '0 4px 6px -1px rgba(0, 0, 0, 0.1)')) %>;
    --button-style-shadow: none;
    --button-style-shadow-color: #000000;
    --button-style-contrast-color: #000000;
    --button-style-radius: <%= theme.btnRadius || '0px' %>;
    --button-style-inner-radius: min(var(--button-style-radius), max(4px, calc(var(--button-style-radius) - 8px)));
    --link-content-radius: min(var(--button-style-inner-radius), 14px);
    --desktop-frame-color: color-mix(in srgb, <%= theme.bgColor1 || '#0B152C' %> 88%, black 12%);
    --header-text-color: <%= theme.fontColor || '#fce7ff' %>;
    --background-contrast-color: #ffffff;
    --backdrop-contrast-color: #ffffff;
    --backdrop-contrast-color-inverse: #000000;
    --bodyText: <%= theme.fontColor || '#fce7ff' %>;
    --linkBackground: var(--button-style-background);
    --linkText: var(--button-style-text);
    --linkHoverBackground: var(--button-style-background-hover);
    --linkHoverText: var(--button-style-text);
    --profileBackground: <%= theme.bgColor1 || '#0B152C' %>;
    --profileTitleText: <%= theme.fontColor || '#fce7ff' %>;
    --profileDescriptionText: <%= theme.fontColor || '#fce7ff' %>;
    --socialLinkFill: <%= theme.fontColor || '#fce7ff' %>;
    --linkRadius: var(--button-style-radius);
    background-color: var(--profileBackground);

    /* Layout variables */
    --button-style-skeleton-color: rgba(0, 0, 0, 0.05);
    --header-font-family: var(--profileFontFamilyPrimary);
    --header-font-weight: 600;
    --profile-container-desktop-width: 580px;
    --header-bio-font-size: 16px;
    --link-gap: <%= profile.linkGap !== undefined ? profile.linkGap : 14 %>px;
    --button-style-inner-padding: var(--link-gap);
    --link-preview-thumbnail-width: 160px; 
    --defaultAvatarBackground: #000000;
    --defaultAvatarText: #FFFFFF;
    --bannerBackground: <%= theme.fontColor || '#fce7ff' %>;
    --bannerText: #FFF;
    --linkShadow: #000000;
    --profileFontFamilyPrimary: IBM Plex Sans;
    --profileFontFamilySecondary: Inter;
    --profileFontWeightNormal: 500;
    --profileFontWeightBold: 700;
    --profileDescriptionFontWeight: 500;
    --linkTextFontWeight: 500;
    --headerFontWeight: 700;
    --embedLinkTextFontWeight: 500;
    --signupSubmitTextFontWeight: 700;
    --bannerFontWeight: 700;
    --headerFontSize: normal;
    --embedLinkTextFontSize: 14px;
    --signupSubmitTextFontSize: 14px;
    --linkHeaderFontSize: 14px;
    --bannerFontSize: 14px;
    --profileDescriptionLineHeight: 1.5;
    --headerLineHeight: 1.5;
  }

  @media screen and (min-width: 576px) {
    html {
      --profileBackground: var(--desktop-frame-color);
      --headerFontSize: normal;
      --embedLinkTextFontSize: 16px;
      --signupSubmitTextFontSize: 16px;
      --linkHeaderFontSize: 16px;
      --bannerFontSize: 16px;
      --link-preview-thumbnail-width: 224px; 
    }
  }

  /* Background styling */
  <% if(theme.bgType === 'gradient') { %>
    <% if(theme.gradientDirection === 'radial' || theme.gradientDirection === 'circle' || theme.gradientDirection === 'radial-gradient' || theme.gradientDirection === 'ellipse') { %>
  html, body, #profile-backdrop, .bg-profileBackground, #profile-background, #profile-background-backdrop, #profile-frame {
    --profileBackground: transparent;
    background: radial-gradient(circle at center, <%= theme.bgColor1 || '#0B152C' %> 0%, <%= theme.bgColor2 || '#4E769B' %> 100%) !important;
    background-attachment: fixed !important;
  }
    <% } else { %>
  html, body, #profile-backdrop, .bg-profileBackground, #profile-background, #profile-background-backdrop, #profile-frame {
    --profileBackground: transparent;
    background: linear-gradient(<%= theme.gradientDirection || '180deg' %>, <%= theme.bgColor1 || '#0B152C' %> 0%, <%= theme.bgColor2 || '#4E769B' %> 100%) !important;
    background-attachment: fixed !important;
  }
    <% } %>
  @media screen and (min-width: 576px) {
    html {
      --profileBackground: transparent;
      --desktop-frame-color: transparent;
    }
  }
  <% } else { %>
  html, body, #profile-backdrop, .bg-profileBackground, #profile-background, #profile-background-backdrop, #profile-frame {
    --profileBackground: transparent;
    background: <%= theme.bgColor1 || '#0B152C' %> !important;
    background-color: <%= theme.bgColor1 || '#0B152C' %> !important;
  }
  @media screen and (min-width: 576px) {
    html {
      --profileBackground: transparent;
      --desktop-frame-color: transparent;
    }
  }
  <% } %>

  html, body, * {
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
    text-rendering: optimizeLegibility !important;
  }
  img, svg {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: auto;
  }

  /* Button styling enforce */
  [data-testid="NewLinkContainer"] {
    background: var(--button-style-background) !important;
    color: var(--button-style-text) !important;
    border-radius: var(--button-style-radius) !important;
    border: var(--button-style-border) !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    overflow: hidden !important;
    box-shadow: var(--button-style-shadow) !important;
  }
  [data-testid="NewLinkContainer"]:hover {
    background: var(--button-style-background-hover) !important;
    transform: translateY(-2px) scale(1.01) !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
  }
  [data-testid="NewLinkContainer"] * {
    color: inherit !important;
  }
  [data-testid="NewLinkShareButton"] {
    color: var(--button-style-text) !important;
  }
</style>
