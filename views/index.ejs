<%  } else if (secName === 'business_mail' && profile.showBusinessMail !== false) { %>
<% if (profile.businessMail) { %>
<%
  let bmBg = 'rgba(255, 255, 255, 0.15)';
  if (profile.businessMailTransparent) {
    bmBg = 'transparent';
  } else {
    const bmHex = (profile.businessMailColor || '#000000').replace('#', '');
    const bmR = parseInt(bmHex.substring(0, 2), 16) || 0;
    const bmG = parseInt(bmHex.substring(2, 4), 16) || 0;
    const bmB = parseInt(bmHex.substring(4, 6), 16) || 0;
    const bmA = (profile.businessMailOpacity !== undefined ? profile.businessMailOpacity : 100) / 100;
    bmBg = `rgba(${bmR}, ${bmG}, ${bmB}, ${bmA})`;
  }
%>
<div data-section="business_mail" class="flex justify-center w-full" style="<%= mbStyle %>">
