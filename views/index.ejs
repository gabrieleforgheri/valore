    else if (profile.sectionGap !== undefined) gap = profile.sectionGap;
    const mbStyle = i < secOrder.length - 1 ? `margin-bottom: ${gap}px;` : '';

    if (secName === 'profile' && profile.showProfile !== false) {
%>
<div data-section="profile" class="relative w-full flex flex-col items-center" style="<%= mbStyle %>">
